module sh.sysl.markdown
@tests

import sh.sysl.parsing.Span

// The GitHub extensions as API: off unless asked for, each usable alone, the nodes they leave in the
// tree, the spans on those nodes, and an extension's node with no extension to write it.

private gfm_of(src: string) -> string = to_html_with(parse_with(src, gfm()), gfm_html())

private only(e: &Extension) -> ParseOptions
    val r = registry()

    r.add(e)
    ParseOptions(r)

private ext_of(d: Doc, n: NodeId) -> ExtNode
    d.kind(n) match
        Ext(x) -> x
        _ -> ExtNode("", 99, "", false)

private task_of(d: Doc, n: NodeId) -> Option[bool]
    d.kind(n) match
        Item(task) -> task
        _ -> None

private dest_of(d: Doc, n: NodeId) -> string
    d.kind(n) match
        Link(dest, _) -> dest
        _ -> ""

private child(d: Doc, n: NodeId) -> NodeId = d.first_child(n).unwrap()

private next(d: Doc, n: NodeId) -> NodeId = d.next_sibling(n).unwrap()

private table_src() -> string = "| ab | c |\n|:--|--:|\n| d \\| e |\n"

@test("the README's GitHub example renders as it says")
readme_gfm_example()
    val d = parse_with("| a | b |\n|---|--:|\n| ~~c~~ | www.d.com |\n", gfm())

    assert_eq(to_html_with(d, gfm_html()), "<table>\n<thead>\n<tr>\n<th>a</th>\n<th align=\"right\">b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><del>c</del></td>\n<td align=\"right\"><a href=\"http://www.d.com\">www.d.com</a></td>\n</tr>\n</tbody>\n</table>\n")

@test("every extension is off unless a parse asks for it")
extensions_are_off_by_default()
    assert_eq(to_html(parse("| a |\n|-|\n")), "<p>| a |\n|-|</p>\n")
    assert_eq(to_html(parse("~~a~~ www.a.com a@b.cd\n")), "<p>~~a~~ www.a.com a@b.cd</p>\n")
    assert_eq(to_html(parse("- [x] a\n")), "<ul>\n<li>[x] a</li>\n</ul>\n")
    assert_eq(to_html(parse("<script>\n")), "<script>\n")

@test("the GFM preset asks cmark-gfm's four extensions in its order, then GitHub's emoji, math and mermaid")
the_gfm_preset()
    val r = gfm().exts

    assert_eq(r.len(), 7)
    assert_eq(r.at(0).name(), "table")
    assert_eq(r.at(1).name(), "strikethrough")
    assert_eq(r.at(2).name(), "autolink")
    assert_eq(r.at(3).name(), "tasklist")
    assert_eq(r.at(4).name(), "emoji")
    assert_eq(r.at(5).name(), "math")
    assert_eq(r.at(6).name(), "mermaid")
    assert(r.named("autolink").is_some())
    assert(r.named("footnotes").is_none())
    assert(r.named("heading_ids").is_none())
    assert(gfm_html().tagfilter)
    assert(!commonmark_html().tagfilter)

@test("a document keeps the extensions it was read with")
the_document_keeps_its_extensions()
    assert_eq(parse_with("a\n", gfm()).exts.len(), 7)
    assert(parse("a\n").exts.is_empty())
    assert(new_doc("a").exts.is_empty())

@test("each extension works alone")
each_extension_alone()
    val src = "| a |\n|-|\n\n~~b~~ www.c.com\n\n- [ ] d\n"

    assert_eq(to_html(parse_with(src, only(tables()))), "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<p>~~b~~ www.c.com</p>\n<ul>\n<li>[ ] d</li>\n</ul>\n")
    assert_eq(to_html(parse_with(src, only(strikethrough()))), "<p>| a |\n|-|</p>\n<p><del>b</del> www.c.com</p>\n<ul>\n<li>[ ] d</li>\n</ul>\n")
    assert_eq(to_html(parse_with(src, only(autolinks()))), "<p>| a |\n|-|</p>\n<p>~~b~~ <a href=\"http://www.c.com\">www.c.com</a></p>\n<ul>\n<li>[ ] d</li>\n</ul>\n")
    assert_eq(to_html(parse_with(src, only(task_lists()))), "<p>| a |\n|-|</p>\n<p>~~b~~ www.c.com</p>\n<ul>\n<li><input type=\"checkbox\" disabled=\"\" /> d</li>\n</ul>\n")

@test("the tag filter is the rendering's: a GFM parse rendered with the CommonMark preset passes every tag")
the_tag_filter_belongs_to_the_rendering()
    val d = parse_with("<style>\n</style>\n\na <title> b\n", gfm())

    assert_eq(to_html_with(d, gfm_html()), "&lt;style>\n&lt;/style>\n<p>a &lt;title> b</p>\n")
    assert_eq(to_html(d), "<style>\n</style>\n<p>a <title> b</p>\n")
    assert_eq(to_html_with(d, HtmlOptions(false, "\n", None, true, Standard, Standard)), "<!-- raw HTML omitted -->\n<p>a <!-- raw HTML omitted --> b</p>\n")

@test("a table is Ext nodes: the table, a header row, body rows, and cells carrying their alignment")
the_table_nodes()
    val d = parse_with(table_src(), gfm())
    val t = child(d, d.root())
    val head = child(d, t)
    val row = next(d, head)
    val a = child(d, head)
    val c = next(d, a)
    val filled = next(d, child(d, row))

    assert_eq(ext_of(d, t).ext, "table")
    assert_eq(ext_of(d, t).tag, TABLE_NODE)
    assert_eq(ext_of(d, head).tag, TABLE_HEAD_NODE)
    assert_eq(ext_of(d, row).tag, TABLE_ROW_NODE)
    assert_eq(ext_of(d, a).tag, TABLE_CELL_NODE)
    assert_eq(ext_of(d, a).data, "left")
    assert_eq(ext_of(d, c).data, "right")
    assert(ext_of(d, a).holds)
    assert(d.first_child(filled).is_none())
    assert(d.next_sibling(row).is_none())

@test("a table and its cells carry the spans of the source they were read from")
the_table_spans()
    val src = table_src()
    val d = parse_with(src, gfm())
    val t = child(d, d.root())
    val head = child(d, t)
    val a = child(d, head)
    val cell = child(d, next(d, head))

    assert_eq(d.span(t), Span(0, src.len - 1))
    assert_eq(d.span(a), Span(2, 4))
    assert_eq(src[d.span(child(d, a)).start..<d.span(child(d, a)).end], "ab")
    assert_eq(src[d.span(cell).start..<d.span(cell).end], "d \\| e")

    d.kind(child(d, cell)) match
        Text(t) -> assert_eq(t, "d | e")
        _ -> assert(false)

@test("a table that takes a paragraph's last line leaves the paragraph its other lines")
the_paragraph_keeps_its_other_lines()
    val src = "a\nb\n| c |\n|-|\n"
    val d = parse_with(src, gfm())
    val p = child(d, d.root())

    assert_eq(d.span(p), Span(0, 3))
    assert_eq(d.span(next(d, p)).start, 4)
    assert_eq(gfm_of(src), "<p>a\nb</p>\n<table>\n<thead>\n<tr>\n<th>c</th>\n</tr>\n</thead>\n</table>\n")

@test("strikethrough, task lists and autolinks leave nodes a rewrite can read")
the_inline_nodes()
    val d = parse_with("- [x] ~~a~~ www.b.com c@d.ef\n", gfm())
    val item = child(d, child(d, d.root()))
    val para = child(d, item)
    val strike = child(d, para)

    assert_eq(task_of(d, item), Some(true))
    assert_eq(ext_of(d, strike).ext, "strikethrough")
    assert_eq(ext_of(d, strike).tag, STRIKETHROUGH_NODE)

    val www = next(d, next(d, strike))
    val email = next(d, next(d, www))

    assert_eq(dest_of(d, www), "http://www.b.com")
    assert_eq(dest_of(d, email), "mailto:c@d.ef")
    assert_eq(d.span(email), Span(22, 28))

@test("an Ext node no extension of the document's claims writes only what it holds")
an_unclaimed_ext_node()
    val d = new_doc("x")
    val p = d.append_child(d.root(), Paragraph, Span(0, 1))
    val e = d.append_child(p, Ext(ExtNode("nobody", 0, "", true)), Span(0, 1))

    d.append_child(e, Text("x"), Span(0, 1))
    assert_eq(to_html(d), "<p>x</p>\n")
    assert_eq(plain_text(d, d.root()), "x")

@test("the text of a table, a strikethrough and an autolink is their children's")
plain_text_of_extension_nodes()
    val d = parse_with("~~a~~ www.b.com\n", gfm())

    assert_eq(plain_text(d, d.root()), "a www.b.com")
