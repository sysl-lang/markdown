module sh.sysl.markdown

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.text.{Ascii, str_builder}
import sysl.unicode.category

// GitHub's extended autolinks: a URL, a `www.` domain or an email address in running text becomes a
// link without the `<…>` CommonMark asks for.
//
// **The rules are cmark-gfm's**, including where they are not what a reader would guess:
//
// - **`http://`, `https://` and `ftp://`** (in any case) start a link where the letters before the
//   `:` are exactly the scheme; **`www.`** (lower case) starts one at the start of the text or after
//   a space or one of `*`, `_`, `~` and `(`, and links to `http://` and the text. Either needs a
//   domain -- `www.` one with a dot -- and an underscore in its last two labels refuses it, unless
//   it has more than ten. The link runs to the next space or `<`.
// - **An email address** -- letters, digits and `.+-_` before an `@`, a domain with a dot after it,
//   ending in a letter or a `.` -- links to `mailto:` and the address; written `mailto:` or `xmpp:`
//   (which may carry a `/resource`), the link is the text as written. Emails are found after every
//   other inline has been read, in the text between them, so `foo_bar@baz.com` is one address
//   however the `_` was first read.
// - **Trailing punctuation is not part of a link**: `?!.,:*_~'"` at the end comes off, a `)` comes
//   off only where it has no `(` to close, and an entity reference such as `&amp;` at the end comes
//   off whole.
// - **Inside a link's brackets nothing is autolinked**, nor inside a link's text afterwards.

/** The extended autolink extension, for a `Registry`. */
autolinks() -> &Extension = Autolinks()

private struct Autolinks
end Autolinks

impl Extension for Autolinks
    name(self) -> string = "autolink"

    override triggers(self) -> string = "whHfF"

    override inline_match(self, s: Subject) -> InlineMatch
        if s.in_brackets then return NoMatch

        val b = s.text.bytes

        val n = if b[s.pos] == u8('w') then www_link(b, s.pos) else url_link(b, s.pos)

        if n == 0 then return NoMatch

        val text = s.text[s.pos..<s.pos + n]
        val dest = if b[s.pos] == u8('w') then s"http://$text" else text

        Inline(Link(dest, ""), n)

    override post_pass(self, d: Doc)
        var texts: Buf[NodeId] = buf()
        var in_link = false

        for (ev, n) in d.walk()
            d.kind(n) match
                Link(_, _) -> in_link = ev == Enter
                Text(_) ->
                    if !in_link then
                        val first = d.prev_sibling(n) match
                            Some(p) -> !is_text(d, p)
                            None -> true

                        if first then texts.push(n)
                _ -> ()

        for n in texts.view() do emails(d, joined(d, n))

private is_text(d: Doc, n: NodeId) -> bool
    d.kind(n) match
        Text(_) -> true
        _ -> false

// The run of `Text` siblings starting at `n` made one node, as cmark-gfm consolidates them before it
// looks for an address: an escape or an emphasis delimiter that paired with nothing leaves a run of
// several.
private joined(d: Doc, n: NodeId) -> NodeId
    var next = d.next_sibling(n)

    if next.is_none() || !is_text(d, next.unwrap()) then return n

    var b = str_builder()
    var stop = d.span(n).end

    b.push(lit_of(d, n))

    loop
        next match
            Some(m) ->
                if !is_text(d, m) then break

                b.push(lit_of(d, m))
                stop = d.span(m).end
                next = d.next_sibling(m)
                d.unlink(m)
            None -> break

    d.set_kind(n, Text(b.finish()))
    d.set_span(n, Span(d.span(n).start, stop))
    n
end joined

private lit_of(d: Doc, n: NodeId) -> string
    d.kind(n) match
        Text(t) -> t
        _ -> ""

// cmark-gfm's `postprocess_text`: every email address in the text node `n` made a link, the node
// split around each.
private emails(d: Doc, n0: NodeId)
    var n = n0
    val whole = lit_of(d, n)
    val data = whole.bytes
    val span = d.span(n)
    val exact = span.end - span.start == data.len
    var start: usize = 0
    var offset: usize = 0
    var remaining = data.len

    loop
        if offset >= remaining then break

        var at = start + offset

        while at < start + remaining && data[at] != u8('@') do at += 1

        if at >= start + remaining then break

        var max_rewind = at - (start + offset)
        var auto_mailto = true
        var is_xmpp = false
        var np: usize = 0
        var rewind: usize = 0
        var link_end: usize = 0
        var retry = true

        while retry
            retry = false
            rewind = 0

            while rewind < max_rewind
                val here = start + offset + max_rewind
                val c = data[here - rewind - 1]

                if c.is_alnum() || c == u8('.') || c == u8('+') || c == u8('-') || c == u8('_') then
                    rewind += 1
                    continue

                if c == u8(':') then
                    if protocol_before(data, here, "mailto:", rewind, max_rewind) then
                        auto_mailto = false
                        rewind += 1
                        continue

                    if protocol_before(data, here, "xmpp:", rewind, max_rewind) then
                        auto_mailto = false
                        is_xmpp = true
                        rewind += 1
                        continue

                break

            if rewind == 0 then break

            link_end = 1

            while link_end < remaining - offset - max_rewind
                val c = data[start + offset + max_rewind + link_end]

                if c.is_alnum() then
                    link_end += 1
                else if c == u8('@') then
                    offset += max_rewind + 1
                    max_rewind = link_end - 1
                    retry = true
                    break
                else if c == u8('.') && link_end < remaining - offset - max_rewind - 1 && data[start + offset + max_rewind + link_end + 1].is_alnum() then
                    np += 1
                    link_end += 1
                else if c == u8('/') && is_xmpp then
                    link_end += 1
                else if c != u8('-') && c != u8('_') then
                    break
                else
                    link_end += 1
        end while

        if rewind == 0 then
            offset += max_rewind + 1
            continue

        val last = data[start + offset + max_rewind + link_end - 1]

        if link_end < 2 || np == 0 || (!last.is_alpha() && last != u8('.')) then
            offset += max_rewind + link_end
            continue

        link_end = trailing_punctuation(data, start + offset + max_rewind, link_end)

        if link_end == 0 then
            offset += max_rewind + 1
            continue

        val from = start + offset + max_rewind - rewind
        val to = start + offset + max_rewind + link_end
        val address = whole[from..<to]
        val dest = if auto_mailto then s"mailto:$address" else address
        val parent = d.parent(n).unwrap()
        val link = d.append_child(parent, Link(dest, ""), sub_span(span, exact, from, to))

        d.append_child(link, Text(address), sub_span(span, exact, from, to))
        d.insert_after(n, link)
        d.set_kind(n, Text(whole[start..<from]))
        d.set_span(n, sub_span(span, exact, start, from))

        val post = d.append_child(parent, Text(whole[to..<data.len]), sub_span(span, exact, to, data.len))

        d.insert_after(link, post)

        if from == start then d.unlink(n)

        n = post
        start = to
        remaining = data.len - to
        offset = 0

    if remaining == 0 then d.unlink(n)
end emails

// A piece of a text node's span: exact where the node's text is its source byte for byte, and the
// whole span where an escape or a reference made the two differ.
private sub_span(s: Span, exact: bool, from: usize, to: usize) -> Span = if exact then Span(s.start + from, s.start + to) else s

// cmark-gfm's `validate_protocol`: whether `protocol`, ending in the `:` just before the `rewind`
// bytes already taken back from `here`, is written there, at the start of the text or after
// something that is not a letter or a digit.
private protocol_before(data: []const u8, here: usize, protocol: string, rewind: usize, max_rewind: usize) -> bool
    val p = protocol.bytes

    if p.len > max_rewind - rewind then return false

    val s = here - rewind - p.len

    for k in 0..<p.len
        if data[s + k] != p[k] then return false

    p.len == max_rewind - rewind || !data[s - 1].is_alnum()

// cmark-gfm's `www_match`: how many bytes from `p` a `www.` link takes, or 0.
private www_link(b: []const u8, p: usize) -> usize
    if p > 0 then
        val c = b[p - 1]

        if c != 0 && c != u8('*') && c != u8('_') && c != u8('~') && c != u8('(') && !is_c_space(c) then return 0

    if b.len - p < 4 || b[p + 1] != u8('w') || b[p + 2] != u8('w') || b[p + 3] != u8('.') then return 0

    var stop = domain_end(b, p, b.len, false)

    if stop == 0 then return 0

    while p + stop < b.len && !is_c_space(b[p + stop]) && b[p + stop] != u8('<') do stop += 1

    trailing_punctuation(b, p, stop)

// cmark-gfm's `url_match`, entered at the scheme's first letter rather than at its `:`: how many bytes
// from `p` a `http://`, `https://` or `ftp://` link takes, or 0. The letters before the `:` have to be
// the scheme and nothing more.
private url_link(b: []const u8, p: usize) -> usize
    if p > 0 && b[p - 1].is_alpha() then return 0

    var colon = p

    while colon < b.len && b[colon].is_alpha() do colon += 1

    val scheme = lower_word(b, p, colon)

    if scheme != "http" && scheme != "https" && scheme != "ftp" then return 0

    if b.len - colon < 4 || b[colon] != u8(':') || b[colon + 1] != u8('/') || b[colon + 2] != u8('/') then return 0

    if !is_host_char(b, colon + 3) then return 0

    val domain = domain_end(b, colon + 3, b.len, true)

    if domain == 0 then return 0

    var stop = 3 + domain

    while colon + stop < b.len && !is_c_space(b[colon + stop]) && b[colon + stop] != u8('<') do stop += 1

    stop = trailing_punctuation(b, colon, stop)

    if stop == 0 then 0 else colon - p + stop

private lower_word(b: []const u8, from: usize, to: usize) -> string
    if to - from > 5 then return ""

    var s = str_builder()

    for i in from..<to do s.push_char(char(if b[i] >= u8('A') && b[i] <= u8('Z') then b[i] + 32 else b[i]))

    s.finish()

// cmark-gfm's `check_domain` over `b[d..<e]`: how far the domain goes, or 0 where it is refused --
// for an underscore in either of its last two labels (unless it has more than ten), or, unless
// `allow_short`, for having no dot. The last byte of the text is never looked at, as there.
private domain_end(b: []const u8, d: usize, e: usize, allow_short: bool) -> usize
    val size = e - d
    var np: usize = 0
    var uscore1: usize = 0
    var uscore2: usize = 0
    var i: usize = 1

    while i + 1 < size
        if b[d + i] == u8('\\') && i + 2 < size then i += 1

        val c = b[d + i]

        if c == u8('_') then
            uscore2 += 1
        else if c == u8('.') then
            uscore1 = uscore2
            uscore2 = 0
            np += 1
        else if !is_host_char(b, d + i) && c != u8('-') then
            break

        i += 1

    if (uscore1 > 0 || uscore2 > 0) && np <= 10 then return 0

    if allow_short || np > 0 then i else 0
end domain_end

// cmark-gfm's `autolink_delim`: the link `b[d..<d + n]` cut short at a `<`, then of its trailing
// punctuation -- `?!.,:*_~'"`, a `)` with no `(` to close, an entity reference -- one piece at a time.
private trailing_punctuation(b: []const u8, d: usize, n: usize) -> usize
    var stop = n
    var opening: usize = 0
    var closing: usize = 0

    for i in 0..<n
        val c = b[d + i]

        if c == u8('<') then
            stop = i
            break

        if c == u8('(') then opening += 1 else if c == u8(')') then closing += 1

    while stop > 0
        val c = b[d + stop - 1]

        if c == u8(')') then
            if closing <= opening then return stop

            closing -= 1
            stop -= 1
        else if c == u8('?') || c == u8('!') || c == u8('.') || c == u8(',') || c == u8(':') || c == u8('*') || c == u8('_') || c == u8('~') || c == u8('\'') || c == u8('"') then
            stop -= 1
        else if c == u8(';') then
            if stop < 2 then return stop - 1

            var k = stop - 2

            while k > 0 && b[d + k].is_alpha() do k -= 1

            stop = if k < stop - 2 && b[d + k] == u8('&') then k else stop - 1
        else
            return stop

    stop
end trailing_punctuation

// cmark's `cmark_isspace`: ASCII whitespace.
private is_c_space(c: u8) -> bool = c == u8(' ') || c == u8('\t') || c == u8('\n') || c == u8('\r') || c == 11 || c == 12

// cmark-gfm's `is_valid_hostchar`: the character starting at `i` decodes, and is neither whitespace
// nor punctuation. A byte in the middle of a character does not decode, so a domain stops there.
private is_host_char(b: []const u8, i: usize) -> bool
    val c = b[i]

    if c < 128 then return !is_c_space(c) && !c.is_punct()

    val (cp, ok) = decode_at(b, i)

    if !ok then return false

    if cp == 160 || cp == 5760 || (cp >= 8192 && cp <= 8202) || cp == 8239 || cp == 8287 || cp == 12288 then return false

    category(char(cp)) match
        Pc | Pd | Ps | Pe | Pi | Pf | Po -> false
        _ -> true

// The scalar value of the UTF-8 sequence starting at `i`, and whether there is a well-formed one.
private decode_at(b: []const u8, i: usize) -> (u32, bool)
    val c = b[i]
    val n: usize = if c >= 0xC2 && c <= 0xDF then 2 else if c >= 0xE0 && c <= 0xEF then 3 else if c >= 0xF0 && c <= 0xF4 then 4 else 0

    if n == 0 || i + n > b.len then return (0, false)

    var cp = u32(c) & (if n == 2 then 0x1F else if n == 3 then 0x0F else 0x07)

    for k in 1..<n
        val d = b[i + k]

        if d < 0x80 || d > 0xBF then return (0, false)

        cp = (cp << 6) | u32(d & 0x3F)

    val least: u32 = if n == 3 then 0x800 else if n == 4 then 0x10000 else 0x80

    if cp < least || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) then return (0, false)

    (cp, true)
