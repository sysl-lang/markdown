module sh.sysl.markdown

// The seven kinds of HTML block, told apart by how their first line begins (the spec's "start
// conditions"), and the line that ends each.
//
// | | begins with | ends at a line containing |
// |---|---|---|
// | 1 | `<pre`, `<script`, `<style` or `<textarea`, then a space, a tab, `>` or the line's end | `</pre>`, `</script>`, `</style>` or `</textarea>` |
// | 2 | `<!--` | `-->` |
// | 3 | `<?` | `?>` |
// | 4 | `<!` and an ASCII letter | `>` |
// | 5 | `<![CDATA[` | `]]>` |
// | 6 | `<` or `</` and a block-level tag name, then a space, a tab, `>`, `/>` or the line's end | a blank line |
// | 7 | a whole open tag of any other name, or a whole closing tag of any name, and nothing after it but spaces and tabs | a blank line |
//
// Tag names are compared without regard to case. The first five end on the line that holds their
// end marker, which may be the line they began on; the last two end before a blank line. Only the
// seventh may not interrupt a paragraph.
//
// The tag scanners are the spec's definitions of an open and a closing tag, and are written to be
// shared with raw HTML inside a paragraph: inside one line no line ending occurs, and across lines a
// tag may hold one.

private const RAW_TAGS: string = "pre script style textarea"

private const BLOCK_TAGS: string = "address article aside base basefont blockquote body caption center col colgroup dd details dialog dir div dl dt fieldset figcaption figure footer form frame frameset h1 h2 h3 h4 h5 h6 head header hr html iframe legend li link main menu menuitem nav noframes ol optgroup option p param search section summary table tbody td tfoot th thead title tr track ul"

/** The start condition, 1 to 7, that a line meets with `<` at `p`, or 0 for none. `in_para` rules
 * out the seventh, which may not interrupt a paragraph.
 */
private[markdown] html_block_start(b: []const u8, p: usize, in_para: bool) -> u8
    if byte_at(b, p) != u8('<') then return 0

    val q = p + 1
    val name_end = tag_name_end(b, q)

    if name_end > q && in_words(RAW_TAGS, b, q, name_end) then
        val after = byte_at(b, name_end)

        if name_end == b.len || is_space_or_tab(after) || after == u8('>') then return 1

    if starts_with_ci(b, q, "!--") then return 2
    if byte_at(b, q) == u8('?') then return 3
    if starts_with_exact(b, q, "![CDATA[") then return 5
    if byte_at(b, q) == u8('!') && is_ascii_letter(byte_at(b, q + 1)) then return 4

    val s = if byte_at(b, q) == u8('/') then q + 1 else q
    val e = tag_name_end(b, s)

    if e > s && in_words(BLOCK_TAGS, b, s, e) then
        val after = byte_at(b, e)

        if e == b.len || is_space_or_tab(after) || after == u8('>') then return 6
        if after == u8('/') && byte_at(b, e + 1) == u8('>') then return 6

    // The four raw names are refused only as open tags: `</script>` alone on a line is a closing tag
    // like any other, and begins a block of the seventh kind.
    if in_para || e == s || (s == q && in_words(RAW_TAGS, b, s, e)) then return 0

    val end = if s > q then closing_tag_end(b, p) else open_tag_end(b, p)

    if end == 0 then return 0

    for i in end..<b.len
        if !is_space_or_tab(b[i]) then return 0

    7
end html_block_start

/** Whether `line` holds the end marker of an HTML block of start condition `cond`; never for the
 * sixth and seventh, which end at a blank line instead.
 */
private[markdown] html_block_ends(cond: u8, line: []const u8) -> bool
    cond match
        1 -> contains_ci(line, "</pre>") || contains_ci(line, "</script>") || contains_ci(line, "</style>") || contains_ci(line, "</textarea>")
        2 -> contains_ci(line, "-->")
        3 -> contains_ci(line, "?>")
        4 -> contains_ci(line, ">")
        5 -> contains_ci(line, "]]>")
        _ -> false

/** One past the `>` of an open tag beginning with `<` at `p`, or 0 where none begins there. */
private[markdown] open_tag_end(b: []const u8, p: usize) -> usize
    if byte_at(b, p) != u8('<') then return 0

    var i = tag_name_end(b, p + 1)

    if i == p + 1 then return 0

    loop
        val ws = skip_tag_space(b, i)

        if ws == i || !is_attr_name_start(byte_at(b, ws)) then
            i = ws
            break

        i = ws + 1
        while is_attr_name_char(byte_at(b, i)) do i += 1

        val eq = skip_tag_space(b, i)

        if byte_at(b, eq) == u8('=') then
            val v = attr_value_end(b, skip_tag_space(b, eq + 1))

            if v == 0 then return 0

            i = v

    if byte_at(b, i) == u8('/') then i += 1
    if byte_at(b, i) == u8('>') then i + 1 else 0
end open_tag_end

/** One past the `>` of a closing tag beginning with `</` at `p`, or 0 where none begins there. */
private[markdown] closing_tag_end(b: []const u8, p: usize) -> usize
    if byte_at(b, p) != u8('<') || byte_at(b, p + 1) != u8('/') then return 0

    val e = tag_name_end(b, p + 2)

    if e == p + 2 then return 0

    val i = skip_tag_space(b, e)

    if byte_at(b, i) == u8('>') then i + 1 else 0

// The end of a tag name starting at `i` -- an ASCII letter, then letters, digits and `-` -- or `i`
// itself where none starts there.
private tag_name_end(b: []const u8, i: usize) -> usize
    if !is_ascii_letter(byte_at(b, i)) then return i

    var e = i + 1

    while is_ascii_letter(byte_at(b, e)) || is_ascii_digit(byte_at(b, e)) || byte_at(b, e) == u8('-') do e += 1

    e

// Spaces and tabs from `i`, with at most one line ending among them.
private skip_tag_space(b: []const u8, i: usize) -> usize
    var j = i
    var endings = 0

    loop
        val c = byte_at(b, j)

        if is_space_or_tab(c) then
            j += 1
        else if (c == u8('\n') || c == u8('\r')) && endings == 0 then
            endings = 1
            j += if c == u8('\r') && byte_at(b, j + 1) == u8('\n') then 2 else 1
        else
            return j
end skip_tag_space

// The end of an attribute value starting at `i`: unquoted, single-quoted or double-quoted. Zero
// where none starts there.
private attr_value_end(b: []const u8, i: usize) -> usize
    val q = byte_at(b, i)

    if q == u8('"') || q == u8('\'') then
        var j = i + 1

        while j < b.len && b[j] != q do j += 1

        return if j < b.len then j + 1 else 0

    var j = i

    while j < b.len && !ends_unquoted(b[j]) do j += 1

    if j > i then j else 0

private ends_unquoted(c: u8) -> bool
    is_space_or_tab(c) || c == u8('\n') || c == u8('\r') || c == u8('"') || c == u8('\'') ||
        c == u8('=') || c == u8('<') || c == u8('>') || c == u8('`')

private is_attr_name_start(c: u8) -> bool = is_ascii_letter(c) || c == u8('_') || c == u8(':')

private is_attr_name_char(c: u8) -> bool = is_attr_name_start(c) || is_ascii_digit(c) || c == u8('.') || c == u8('-')

private[markdown] is_ascii_letter(c: u8) -> bool = (c >= u8('a') && c <= u8('z')) || (c >= u8('A') && c <= u8('Z'))

private[markdown] is_ascii_digit(c: u8) -> bool = c >= u8('0') && c <= u8('9')

private[markdown] byte_at(b: []const u8, i: usize) -> u8 = if i < b.len then b[i] else 0

private to_lower(c: u8) -> u8 = if c >= u8('A') && c <= u8('Z') then c + 32 else c

// Whether `b` holds `word` at `i`, letters compared without regard to case. `word` is lower case.
private starts_with_ci(b: []const u8, i: usize, word: string) -> bool
    val w = word.bytes

    if i + w.len > b.len then return false

    for k in 0..<w.len
        if to_lower(b[i + k]) != w[k] then return false

    true

// Whether `b` holds exactly `word` at `i`.
private[markdown] starts_with_exact(b: []const u8, i: usize, word: string) -> bool
    val w = word.bytes

    if i + w.len > b.len then return false

    for k in 0..<w.len
        if b[i + k] != w[k] then return false

    true

// Whether `word`, in lower case, occurs anywhere in `b` without regard to case.
private contains_ci(b: []const u8, word: string) -> bool
    val w = word.bytes

    if w.len > b.len then return false

    for i in 0..<b.len - w.len + 1
        if starts_with_ci(b, i, word) then return true

    false

// Whether `b[s..<e]` is one of the space-separated lower-case words of `list`, without regard to case.
private in_words(list: string, b: []const u8, s: usize, e: usize) -> bool
    val l = list.bytes
    var i: usize = 0

    while i < l.len
        var j = i

        while j < l.len && l[j] != u8(' ') do j += 1

        if j - i == e - s && starts_with_ci(b, s, list[i..<j]) then return true

        i = j + 1

    false
end in_words
