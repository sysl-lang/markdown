module sh.sysl.markdown
@tests

// GitHub alerts, read with gfm() and rendered with gfm_html(), compared exactly. The expected HTML
// is what GitHub's renderer writes (its /markdown API, gfm mode), less the octicon <svg> before the
// title, and with a newline between the title and the body's first block.

@test("alerts: a note")
alert_case_1()
    assert_eq(to_html_with(parse_with("> [!NOTE]\n> Useful *info*.\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<p>Useful <em>info</em>.</p>\n</div>\n")

@test("alerts: a tip")
alert_case_2()
    assert_eq(to_html_with(parse_with("> [!TIP]\n> t\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-tip\">\n<p class=\"markdown-alert-title\">Tip</p>\n<p>t</p>\n</div>\n")

@test("alerts: an important")
alert_case_3()
    assert_eq(to_html_with(parse_with("> [!IMPORTANT]\n> i\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-important\">\n<p class=\"markdown-alert-title\">Important</p>\n<p>i</p>\n</div>\n")

@test("alerts: a warning")
alert_case_4()
    assert_eq(to_html_with(parse_with("> [!WARNING]\n> w\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-warning\">\n<p class=\"markdown-alert-title\">Warning</p>\n<p>w</p>\n</div>\n")

@test("alerts: a caution")
alert_case_5()
    assert_eq(to_html_with(parse_with("> [!CAUTION]\n> c\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-caution\">\n<p class=\"markdown-alert-title\">Caution</p>\n<p>c</p>\n</div>\n")

@test("alerts: the marker in any case")
alert_case_6()
    assert_eq(to_html_with(parse_with("> [!tip]\n> x\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-tip\">\n<p class=\"markdown-alert-title\">Tip</p>\n<p>x</p>\n</div>\n")

@test("alerts: the marker in mixed case")
alert_case_7()
    assert_eq(to_html_with(parse_with("> [!WaRnInG]\n> x\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-warning\">\n<p class=\"markdown-alert-title\">Warning</p>\n<p>x</p>\n</div>\n")

@test("alerts: a lazy line after the marker")
alert_case_8()
    assert_eq(to_html_with(parse_with("> [!NOTE]\nlazy line\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<p>lazy line</p>\n</div>\n")

@test("alerts: a blank line after the marker")
alert_case_9()
    assert_eq(to_html_with(parse_with("> [!NOTE]\n>\n> after blank\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<p>after blank</p>\n</div>\n")

@test("alerts: several paragraphs")
alert_case_10()
    assert_eq(to_html_with(parse_with("> [!NOTE]\n> one\n>\n> two\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<p>one</p>\n<p>two</p>\n</div>\n")

@test("alerts: a list after the marker")
alert_case_11()
    assert_eq(to_html_with(parse_with(">[!WARNING]\n> - item\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-warning\">\n<p class=\"markdown-alert-title\">Warning</p>\n<ul>\n<li>item</li>\n</ul>\n</div>\n")

@test("alerts: a code block in the body")
alert_case_12()
    assert_eq(to_html_with(parse_with("> [!NOTE]\n> ```\n> code\n> ```\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<pre><code>code\n</code></pre>\n</div>\n")

@test("alerts: an indented quote")
alert_case_13()
    assert_eq(to_html_with(parse_with("   > [!CAUTION]\n   > indented\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-caution\">\n<p class=\"markdown-alert-title\">Caution</p>\n<p>indented</p>\n</div>\n")

@test("alerts: spaces after the marker")
alert_case_14()
    assert_eq(to_html_with(parse_with("> [!NOTE]  \n> trailing spaces\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<p>trailing spaces</p>\n</div>\n")

@test("alerts: a tab after the marker")
alert_case_15()
    assert_eq(to_html_with(parse_with("> [!NOTE]\t\n> tab\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<p>tab</p>\n</div>\n")

@test("alerts: an empty first line")
alert_case_16()
    assert_eq(to_html_with(parse_with(">\n> [!NOTE]\n> after an empty line\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<p>after an empty line</p>\n</div>\n")

@test("alerts: an escaped bracket is still a marker")
alert_case_17()
    assert_eq(to_html_with(parse_with("> \\[!NOTE]\n> esc\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<p>esc</p>\n</div>\n")

@test("alerts: an entity is still a marker")
alert_case_18()
    assert_eq(to_html_with(parse_with("> [&#33;NOTE]\n> ent\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<p>ent</p>\n</div>\n")

@test("alerts: a backslash break after the marker")
alert_case_19()
    assert_eq(to_html_with(parse_with("> [!NOTE]\\\n> b\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<p>b</p>\n</div>\n")

@test("alerts: a second marker is text")
alert_case_20()
    assert_eq(to_html_with(parse_with("> [!TIP]\n> [!NOTE]\n> two\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-tip\">\n<p class=\"markdown-alert-title\">Tip</p>\n<p>[!NOTE]\ntwo</p>\n</div>\n")

@test("alerts: an alert after a paragraph")
alert_case_21()
    assert_eq(to_html_with(parse_with("para\n> [!NOTE]\n> x\n", gfm()), gfm_html()), "<p>para</p>\n<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<p>x</p>\n</div>\n")

@test("alerts: an inner quote stays a quote")
alert_case_22()
    assert_eq(to_html_with(parse_with("> [!NOTE]\n> > [!TIP]\n> > inner\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<blockquote>\n<p>[!TIP]\ninner</p>\n</blockquote>\n</div>\n")

@test("alerts: an unknown kind is a quote")
alert_case_23()
    assert_eq(to_html_with(parse_with("> [!FOO]\n> x\n", gfm()), gfm_html()), "<blockquote>\n<p>[!FOO]\nx</p>\n</blockquote>\n")

@test("alerts: a marker alone is a quote")
alert_case_24()
    assert_eq(to_html_with(parse_with("> [!NOTE]\n", gfm()), gfm_html()), "<blockquote>\n<p>[!NOTE]</p>\n</blockquote>\n")

@test("alerts: a marker and blank lines is a quote")
alert_case_25()
    assert_eq(to_html_with(parse_with("> [!NOTE]\n>\n>\n", gfm()), gfm_html()), "<blockquote>\n<p>[!NOTE]</p>\n</blockquote>\n")

@test("alerts: text after the marker makes a quote")
alert_case_26()
    assert_eq(to_html_with(parse_with("> [!WARNING] extra\n> x\n", gfm()), gfm_html()), "<blockquote>\n<p>[!WARNING] extra\nx</p>\n</blockquote>\n")

@test("alerts: a space in the marker makes a quote")
alert_case_27()
    assert_eq(to_html_with(parse_with("> [!NOTE ]\n> sp\n", gfm()), gfm_html()), "<blockquote>\n<p>[!NOTE ]\nsp</p>\n</blockquote>\n")

@test("alerts: an emphasised marker is a quote")
alert_case_28()
    assert_eq(to_html_with(parse_with("> *[!NOTE]*\n> x\n", gfm()), gfm_html()), "<blockquote>\n<p><em>[!NOTE]</em>\nx</p>\n</blockquote>\n")

@test("alerts: a marker on the second line is a quote")
alert_case_29()
    assert_eq(to_html_with(parse_with("> a\n> [!NOTE]\n> b\n", gfm()), gfm_html()), "<blockquote>\n<p>a\n[!NOTE]\nb</p>\n</blockquote>\n")

@test("alerts: a marker that is a link is a quote")
alert_case_30()
    assert_eq(to_html_with(parse_with("[!note]: /url\n\n> [!NOTE]\n> x\n", gfm()), gfm_html()), "<blockquote>\n<p><a href=\"/url\">!NOTE</a>\nx</p>\n</blockquote>\n")

@test("alerts: a setext heading is a quote")
alert_case_31()
    assert_eq(to_html_with(parse_with("> [!NOTE]\n> text\n> ---\n", gfm()), gfm_html()), "<blockquote>\n<h2>[!NOTE]\ntext</h2>\n</blockquote>\n")

@test("alerts: a nested quote is a quote")
alert_case_32()
    assert_eq(to_html_with(parse_with("> > [!NOTE]\n> > nested\n", gfm()), gfm_html()), "<blockquote>\n<blockquote>\n<p>[!NOTE]\nnested</p>\n</blockquote>\n</blockquote>\n")

@test("alerts: in a list item it is a quote")
alert_case_33()
    assert_eq(to_html_with(parse_with("- > [!TIP]\n  > in list\n", gfm()), gfm_html()), "<ul>\n<li>\n<blockquote>\n<p>[!TIP]\nin list</p>\n</blockquote>\n</li>\n</ul>\n")

@test("alerts: a footnote in an alert")
alert_case_34()
    assert_eq(to_html_with(parse_with("> [!NOTE]\n> a[^1]\n\n[^1]: fn\n", gfm()), gfm_html()), "<div class=\"markdown-alert markdown-alert-note\">\n<p class=\"markdown-alert-title\">Note</p>\n<p>a<sup class=\"footnote-ref\"><a href=\"#fn-1\" id=\"fnref-1\" data-footnote-ref>1</a></sup></p>\n</div>\n<section class=\"footnotes\" data-footnotes>\n<ol>\n<li id=\"fn-1\">\n<p>fn <a href=\"#fnref-1\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"1\" aria-label=\"Back to reference 1\">\u{21a9}</a></p>\n</li>\n</ol>\n</section>\n")

@test("alerts: off in the CommonMark preset")
alerts_off_by_default()
    assert_eq(to_html(parse("> [!NOTE]\n> x\n")), "<blockquote>\n<p>[!NOTE]\nx</p>\n</blockquote>\n")

@test("alerts: the node carries its kind")
alert_node_kind()
    val d = parse_with("> [!Caution]\n> x\n", gfm())

    d.kind(d.first_child(d.root()).unwrap()) match
        Ext(x) -> assert_eq(x.ext + ":" + x.data, "alert:caution")
        _ -> panic("not an alert")
