module sh.sysl.markdown

@tests

// github-slugger's own fixtures, in order, through one slugger as its test runs them -- the
// duplicates in the list are numbered against the slugs before them. Written by
// tools/gen_github_tables.py from spec/github-slugger-fixtures.json; edit that, not this.

@test
github_slugger_fixtures()
    var s = slugger()


    // Basic usage
    assert_eq(s.unique(github_slug("alpha")), "alpha")

    // Basic usage (again)
    assert_eq(s.unique(github_slug("alpha")), "alpha-1")

    // Camelcase
    assert_eq(s.unique(github_slug("bravoCharlieDelta")), "bravocharliedelta")

    // Prototypal injection: proto
    assert_eq(s.unique(github_slug("__proto__")), "__proto__")

    // Prototypal injection: proto (again)
    assert_eq(s.unique(github_slug("__proto__")), "__proto__-1")

    // Prototypal injection: has own
    assert_eq(s.unique(github_slug("hasOwnProperty")), "hasownproperty")

    // Repetition (1)
    assert_eq(s.unique(github_slug("echo")), "echo")

    // Repetition (2)
    assert_eq(s.unique(github_slug("echo")), "echo-1")

    // Repetition (3)
    assert_eq(s.unique(github_slug("echo 1")), "echo-1-1")

    // Repetition (4)
    assert_eq(s.unique(github_slug("echo-1")), "echo-1-2")

    // Repetition (5)
    assert_eq(s.unique(github_slug("echo")), "echo-2")

    // More repetition (1)
    assert_eq(s.unique(github_slug("foxtrot-1")), "foxtrot-1")

    // More repetition (2)
    assert_eq(s.unique(github_slug("foxtrot")), "foxtrot")

    // More repetition (3)
    assert_eq(s.unique(github_slug("foxtrot")), "foxtrot-2")

    // Characters: dash
    assert_eq(s.unique(github_slug("heading with a - dash")), "heading-with-a---dash")

    // Characters: underscore
    assert_eq(s.unique(github_slug("heading with an _ underscore")), "heading-with-an-_-underscore")

    // Characters: dot
    assert_eq(s.unique(github_slug("heading with a period.txt")), "heading-with-a-periodtxt")

    // Characters: dots, parents, brackets
    assert_eq(s.unique(github_slug("exchange.bind_headers(exchange, routing [, bindCallback])")), "exchangebind_headersexchange-routing--bindcallback")

    // Characters: space
    assert_eq(s.unique(github_slug(" ")), "-")

    // Characters: initial space
    assert_eq(s.unique(github_slug(" a")), "-a")

    // Characters: final space
    assert_eq(s.unique(github_slug("a ")), "a-")

    // Characters: initial and final spaces
    assert_eq(s.unique(github_slug(" a ")), "-a-")

    // Characters: initial and final dashes
    assert_eq(s.unique(github_slug("-a-")), "-a--1")

    // Characters: apostrophe
    assert_eq(s.unique(github_slug("apostrophe\u{2019}s should be trimmed")), "apostrophes-should-be-trimmed")

    // Some more duplicates (1)
    assert_eq(s.unique(github_slug("golf")), "golf")

    // Some more duplicates (2)
    assert_eq(s.unique(github_slug("golf")), "golf-1")

    // Some more duplicates (3)
    assert_eq(s.unique(github_slug("golf")), "golf-2")

    // Non-ascii: \u{2665}
    assert_eq(s.unique(github_slug("I \u{2665} unicode")), "i--unicode")

    // Non-ascii: -
    assert_eq(s.unique(github_slug("dash-dash")), "dash-dash")

    // Non-ascii: \u{2013}
    assert_eq(s.unique(github_slug("en\u{2013}dash")), "endash")

    // Non-ascii: \u{2013}
    assert_eq(s.unique(github_slug("em\u{2013}dash")), "emdash")

    // Non-ascii: \u{1f604}
    assert_eq(s.unique(github_slug("\u{1f604} unicode emoji")), "-unicode-emoji")

    // Non-ascii: \u{1f604}-\u{1f604}
    assert_eq(s.unique(github_slug("\u{1f604}-\u{1f604} unicode emoji")), "--unicode-emoji")

    // Non-ascii: \u{1f604}_\u{1f604}
    assert_eq(s.unique(github_slug("\u{1f604}_\u{1f604} unicode emoji")), "_-unicode-emoji")

    // Non-ascii: \u{1f604}
    assert_eq(s.unique(github_slug("\u{1f604} - an emoji")), "---an-emoji")

    // Non-ascii: :smile:
    assert_eq(s.unique(github_slug(":smile: - a gemoji")), "smile---a-gemoji")

    // Non-ascii: Cyrillic (1)
    assert_eq(s.unique(github_slug("\u{41f}\u{440}\u{438}\u{432}\u{435}\u{442}")), "\u{43f}\u{440}\u{438}\u{432}\u{435}\u{442}")

    // Non-ascii: Cyrillic (2)
    assert_eq(s.unique(github_slug("\u{41f}\u{440}\u{43e}\u{444}\u{438}\u{43b}\u{438} \u{43f}\u{43e}\u{43b}\u{44c}\u{437}\u{43e}\u{432}\u{430}\u{442}\u{435}\u{43b}\u{435}\u{439}")), "\u{43f}\u{440}\u{43e}\u{444}\u{438}\u{43b}\u{438}-\u{43f}\u{43e}\u{43b}\u{44c}\u{437}\u{43e}\u{432}\u{430}\u{442}\u{435}\u{43b}\u{435}\u{439}")

    // Non-ascii: Cyrillic + Han
    assert_eq(s.unique(github_slug("\u{41f}\u{440}\u{438}\u{432}\u{435}\u{442} non-latin \u{4f60}\u{597d}")), "\u{43f}\u{440}\u{438}\u{432}\u{435}\u{442}-non-latin-\u{4f60}\u{597d}")

    // Gemoji (1)
    assert_eq(s.unique(github_slug(":ok: No underscore")), "ok-no-underscore")

    // Gemoji (2)
    assert_eq(s.unique(github_slug(":ok_hand: Single")), "ok_hand-single")

    // Gemoji (3)
    assert_eq(s.unique(github_slug(":ok_hand::hatched_chick: Two in a row with no spaces")), "ok_handhatched_chick-two-in-a-row-with-no-spaces")

    // Gemoji (4)
    assert_eq(s.unique(github_slug(":ok_hand: :hatched_chick: Two in a row")), "ok_hand-hatched_chick-two-in-a-row")

    // Cased_Letter
    assert_eq(s.unique(github_slug("aA J T d n x \u{c6} \u{d0} \u{db} \u{e5} \u{ef} \u{fa} \u{104} \u{10e} \u{117} \u{121} \u{12b} \u{135} \u{13f} \u{149} \u{153} \u{15d} \u{167} \u{171} \u{17b} \u{185} \u{18f} \u{198} \u{1a2} \u{1ac} \u{1b6} \u{1c5} \u{1cf} \u{1d9} \u{1e3} \u{1ed} \u{1f7} \u{201} \u{20b} \u{215} \u{21f} \u{228} \u{232} \u{23c} \u{246} \u{250} \u{25a} \u{264} \u{26e} \u{278} \u{282} \u{28c} \u{297} \u{2a1} \u{2aa} \u{376} \u{38c} \u{397} \u{3a1} \u{3ac} \u{3b6} \u{3c0} \u{3ca} \u{3d4} \u{3de} \u{3e8} \u{3f2} \u{3fc} \u{406} \u{410} \u{41a} \u{424} \u{42e} \u{438} \u{442} \u{44c} \u{456} \u{460} \u{46a} \u{474} \u{47e} \u{48f} \u{499} \u{4a3} \u{4ad} \u{4b7} \u{4c1} \u{4cb} \u{4d5} \u{4df} \u{4e9} \u{4f3} \u{4fd} \u{507} \u{510} \u{51a} \u{524} \u{52e} \u{539} \u{543} \u{54d} \u{560} \u{56a} \u{574} \u{57e} \u{588} \u{10a9} \u{10b2} \u{10bc} \u{10c7} \u{10d8} \u{10e2} \u{10ec} \u{10f6} \u{13a2} \u{13ac} \u{13b6} \u{13c0} \u{13ca} \u{13d4} \u{13de} \u{13e7} \u{13f1} \u{13fd} \u{1c90} \u{1c9a} \u{1ca4} \u{1cae} \u{1cb8} \u{1d04} \u{1d0e} \u{1d18} \u{1d22} \u{1d6b} \u{1d74} \u{1d7f} \u{1d89} \u{1d93} \u{1e02} \u{1e0c} \u{1e16} \u{1e20} \u{1e2a} \u{1e34} \u{1e3e} \u{1e48} \u{1e52} \u{1e5b} \u{1e65} \u{1e6f} \u{1e79} \u{1e83} \u{1e8d} \u{1e97} \u{1ea1} \u{1eab} \u{1eb5} \u{1ebf} \u{1ec9} \u{1ed3} \u{1edd} \u{1ee6} \u{1ef0} \u{1efa} \u{1f04} \u{1f0e} \u{1f1a} \u{1f26} \u{1f30} \u{1f3a} \u{1f44} \u{1f52} \u{1f60} \u{1f6a} \u{1f73} \u{1f7d} \u{1f89} \u{1f93} \u{1f9d} \u{1fa7} \u{1fb1} \u{1fbc} \u{1fcb} \u{1fda} \u{1fe8} \u{1ff8} \u{210d} \u{211a} \u{212d} \u{213e} \u{2c00} \u{2c0a} \u{2c14} \u{2c1e} \u{2c28} \u{2c33} \u{2c3d} \u{2c47} \u{2c51} \u{2c5b} \u{2c66} \u{2c6f} \u{2c79} \u{2c85} \u{2c8f} \u{2c99} \u{2ca3} \u{2cad} \u{2cb7} \u{2cc1} \u{2ccb} \u{2cd5} \u{2cdf} \u{2cf2} \u{2d07} \u{2d11} \u{2d1b} \u{2d25} \u{a647} \u{a651} \u{a65b} \u{a665} \u{a681} \u{a68b} \u{a695} \u{a725} \u{a72f} \u{a738} \u{a742} \u{a74c} \u{a756} \u{a760} \u{a76a} \u{a775} \u{a77f} \u{a78c} \u{a797} \u{a7a1} \u{a7ab} \u{a7b5} \u{a7bf} \u{ab32} \u{ab3c} \u{ab46} \u{ab50} \u{ab5a} \u{ab71} \u{ab7b} \u{ab85} \u{ab8f} \u{ab99} \u{aba3} \u{abad} \u{abb7} \u{fb00} \u{fb16} \u{ff29} \u{ff33} \u{ff43} \u{ff4d} \u{ff57} \u{10406} \u{10410} \u{1041a} \u{10424} \u{1042e} \u{10438} \u{10441} \u{1044b} \u{104b5} \u{104bf} \u{104c9} \u{104d3} \u{104e1} \u{104eb} \u{104f5} \u{10c83} \u{10c8d} \u{10c97} \u{10ca1} \u{10cab} \u{10cc1} \u{10ccb} \u{10cd5} \u{10cdf} \u{10ce9} \u{118a0} \u{118aa} \u{118b4} \u{118be} \u{118c8} \u{118d2} \u{118dc} \u{16e46} \u{16e4f} \u{16e59} \u{16e63} \u{16e6d} \u{16e77} \u{1d401} \u{1d40b} \u{1d415} \u{1d41f} \u{1d429} \u{1d433} \u{1d43d} \u{1d447} \u{1d450} \u{1d45b} \u{1d465} \u{1d46f} \u{1d479} \u{1d483} \u{1d48d} \u{1d497} \u{1d4a6} \u{1d4b3} \u{1d4bf} \u{1d4ca} \u{1d4d4} \u{1d4de} \u{1d4e7} \u{1d4f1} \u{1d4fb} \u{1d505} \u{1d512} \u{1d51e} \u{1d528} \u{1d532} \u{1d53d} \u{1d54c} \u{1d557} \u{1d561} \u{1d56b} \u{1d574} \u{1d57e} \u{1d588} \u{1d592} \u{1d59c} \u{1d5a6} \u{1d5b0} \u{1d5ba} \u{1d5c4} \u{1d5ce} \u{1d5d8} \u{1d5e2} \u{1d5ec} \u{1d5f5} \u{1d5ff} \u{1d609} \u{1d613} \u{1d61d} \u{1d627} \u{1d631} \u{1d63b} \u{1d645} \u{1d64f} \u{1d659} \u{1d663} \u{1d66d} \u{1d677} \u{1d680} \u{1d68a} \u{1d694} \u{1d69e} \u{1d6aa} \u{1d6b4} \u{1d6be} \u{1d6c9} \u{1d6d3} \u{1d6de} \u{1d6e8} \u{1d6f2} \u{1d6fd} \u{1d706} \u{1d710} \u{1d71b} \u{1d725} \u{1d72f} \u{1d73a} \u{1d744} \u{1d74e} \u{1d759} \u{1d763} \u{1d76d} \u{1d778} \u{1d782} \u{1d78c} \u{1d796} \u{1d7a0} \u{1d7ab} \u{1d7b5} \u{1d7bf} \u{1d7ca} \u{1e908} \u{1e912} \u{1e91c} \u{1e926} \u{1e930} \u{1e93a} \u{1e943}b")), "aa-j-t-d-n-x-\u{e6}-\u{f0}-\u{fb}-\u{e5}-\u{ef}-\u{fa}-\u{105}-\u{10f}-\u{117}-\u{121}-\u{12b}-\u{135}-\u{140}-\u{149}-\u{153}-\u{15d}-\u{167}-\u{171}-\u{17c}-\u{185}-\u{259}-\u{199}-\u{1a3}-\u{1ad}-\u{1b6}-\u{1c6}-\u{1d0}-\u{1da}-\u{1e3}-\u{1ed}-\u{1bf}-\u{201}-\u{20b}-\u{215}-\u{21f}-\u{229}-\u{233}-\u{23c}-\u{247}-\u{250}-\u{25a}-\u{264}-\u{26e}-\u{278}-\u{282}-\u{28c}-\u{297}-\u{2a1}-\u{2aa}-\u{377}-\u{3cc}-\u{3b7}-\u{3c1}-\u{3ac}-\u{3b6}-\u{3c0}-\u{3ca}-\u{3d4}-\u{3df}-\u{3e9}-\u{3f2}-\u{3fc}-\u{456}-\u{430}-\u{43a}-\u{444}-\u{44e}-\u{438}-\u{442}-\u{44c}-\u{456}-\u{461}-\u{46b}-\u{475}-\u{47f}-\u{48f}-\u{499}-\u{4a3}-\u{4ad}-\u{4b7}-\u{4c2}-\u{4cc}-\u{4d5}-\u{4df}-\u{4e9}-\u{4f3}-\u{4fd}-\u{507}-\u{511}-\u{51b}-\u{525}-\u{52f}-\u{569}-\u{573}-\u{57d}-\u{560}-\u{56a}-\u{574}-\u{57e}-\u{588}-\u{2d09}-\u{2d12}-\u{2d1c}-\u{2d27}-\u{10d8}-\u{10e2}-\u{10ec}-\u{10f6}-\u{ab72}-\u{ab7c}-\u{ab86}-\u{ab90}-\u{ab9a}-\u{aba4}-\u{abae}-\u{abb7}-\u{13f9}-\u{13fd}-\u{10d0}-\u{10da}-\u{10e4}-\u{10ee}-\u{10f8}-\u{1d04}-\u{1d0e}-\u{1d18}-\u{1d22}-\u{1d6b}-\u{1d74}-\u{1d7f}-\u{1d89}-\u{1d93}-\u{1e03}-\u{1e0d}-\u{1e17}-\u{1e21}-\u{1e2b}-\u{1e35}-\u{1e3f}-\u{1e49}-\u{1e53}-\u{1e5b}-\u{1e65}-\u{1e6f}-\u{1e79}-\u{1e83}-\u{1e8d}-\u{1e97}-\u{1ea1}-\u{1eab}-\u{1eb5}-\u{1ebf}-\u{1ec9}-\u{1ed3}-\u{1edd}-\u{1ee7}-\u{1ef1}-\u{1efb}-\u{1f04}-\u{1f06}-\u{1f12}-\u{1f26}-\u{1f30}-\u{1f32}-\u{1f44}-\u{1f52}-\u{1f60}-\u{1f62}-\u{1f73}-\u{1f7d}-\u{1f81}-\u{1f93}-\u{1f95}-\u{1fa7}-\u{1fb1}-\u{1fb3}-\u{1f75}-\u{1f76}-\u{1fe0}-\u{1f78}-\u{210d}-\u{211a}-\u{212d}-\u{213e}-\u{2c30}-\u{2c3a}-\u{2c44}-\u{2c4e}-\u{2c58}-\u{2c33}-\u{2c3d}-\u{2c47}-\u{2c51}-\u{2c5b}-\u{2c66}-\u{250}-\u{2c79}-\u{2c85}-\u{2c8f}-\u{2c99}-\u{2ca3}-\u{2cad}-\u{2cb7}-\u{2cc1}-\u{2ccb}-\u{2cd5}-\u{2cdf}-\u{2cf3}-\u{2d07}-\u{2d11}-\u{2d1b}-\u{2d25}-\u{a647}-\u{a651}-\u{a65b}-\u{a665}-\u{a681}-\u{a68b}-\u{a695}-\u{a725}-\u{a72f}-\u{a739}-\u{a743}-\u{a74d}-\u{a757}-\u{a761}-\u{a76b}-\u{a775}-\u{a77f}-\u{a78c}-\u{a797}-\u{a7a1}-\u{25c}-\u{a7b5}-\u{a7bf}-\u{ab32}-\u{ab3c}-\u{ab46}-\u{ab50}-\u{ab5a}-\u{ab71}-\u{ab7b}-\u{ab85}-\u{ab8f}-\u{ab99}-\u{aba3}-\u{abad}-\u{abb7}-\u{fb00}-\u{fb16}-\u{ff49}-\u{ff53}-\u{ff43}-\u{ff4d}-\u{ff57}-\u{1042e}-\u{10438}-\u{10442}-\u{1044c}-\u{1042e}-\u{10438}-\u{10441}-\u{1044b}-\u{104dd}-\u{104e7}-\u{104f1}-\u{104fb}-\u{104e1}-\u{104eb}-\u{104f5}-\u{10cc3}-\u{10ccd}-\u{10cd7}-\u{10ce1}-\u{10ceb}-\u{10cc1}-\u{10ccb}-\u{10cd5}-\u{10cdf}-\u{10ce9}-\u{118c0}-\u{118ca}-\u{118d4}-\u{118de}-\u{118c8}-\u{118d2}-\u{118dc}-\u{16e66}-\u{16e6f}-\u{16e79}-\u{16e63}-\u{16e6d}-\u{16e77}-\u{1d401}-\u{1d40b}-\u{1d415}-\u{1d41f}-\u{1d429}-\u{1d433}-\u{1d43d}-\u{1d447}-\u{1d450}-\u{1d45b}-\u{1d465}-\u{1d46f}-\u{1d479}-\u{1d483}-\u{1d48d}-\u{1d497}-\u{1d4a6}-\u{1d4b3}-\u{1d4bf}-\u{1d4ca}-\u{1d4d4}-\u{1d4de}-\u{1d4e7}-\u{1d4f1}-\u{1d4fb}-\u{1d505}-\u{1d512}-\u{1d51e}-\u{1d528}-\u{1d532}-\u{1d53d}-\u{1d54c}-\u{1d557}-\u{1d561}-\u{1d56b}-\u{1d574}-\u{1d57e}-\u{1d588}-\u{1d592}-\u{1d59c}-\u{1d5a6}-\u{1d5b0}-\u{1d5ba}-\u{1d5c4}-\u{1d5ce}-\u{1d5d8}-\u{1d5e2}-\u{1d5ec}-\u{1d5f5}-\u{1d5ff}-\u{1d609}-\u{1d613}-\u{1d61d}-\u{1d627}-\u{1d631}-\u{1d63b}-\u{1d645}-\u{1d64f}-\u{1d659}-\u{1d663}-\u{1d66d}-\u{1d677}-\u{1d680}-\u{1d68a}-\u{1d694}-\u{1d69e}-\u{1d6aa}-\u{1d6b4}-\u{1d6be}-\u{1d6c9}-\u{1d6d3}-\u{1d6de}-\u{1d6e8}-\u{1d6f2}-\u{1d6fd}-\u{1d706}-\u{1d710}-\u{1d71b}-\u{1d725}-\u{1d72f}-\u{1d73a}-\u{1d744}-\u{1d74e}-\u{1d759}-\u{1d763}-\u{1d76d}-\u{1d778}-\u{1d782}-\u{1d78c}-\u{1d796}-\u{1d7a0}-\u{1d7ab}-\u{1d7b5}-\u{1d7bf}-\u{1d7ca}-\u{1e92a}-\u{1e934}-\u{1e93e}-\u{1e926}-\u{1e930}-\u{1e93a}-\u{1e943}b")

    // Close_Punctuation
    assert_eq(s.unique(github_slug("a) ] \u{7d} \u{f3b} \u{f3d} \u{169c} \u{2046} \u{207e} \u{208e} \u{2309} \u{230b} \u{232a} \u{2769} \u{276b} \u{276d} \u{276f} \u{2771} \u{2773} \u{2775} \u{27c6} \u{27e7} \u{27e9} \u{27eb} \u{27ed} \u{27ef} \u{2984} \u{2986} \u{2988} \u{298a} \u{298c} \u{298e} \u{2990} \u{2992} \u{2994} \u{2996} \u{2998} \u{29d9} \u{29db} \u{29fd} \u{2e23} \u{2e25} \u{2e27} \u{2e29} \u{3009} \u{300b} \u{300d} \u{300f} \u{3011} \u{3015} \u{3017} \u{3019} \u{301b} \u{301e} \u{301f} \u{fd3e} \u{fe18} \u{fe36} \u{fe38} \u{fe3a} \u{fe3c} \u{fe3e} \u{fe40} \u{fe42} \u{fe44} \u{fe48} \u{fe5a} \u{fe5c} \u{fe5e} \u{ff09} \u{ff3d} \u{ff5d} \u{ff60} \u{ff63}b")), "a------------------------------------------------------------------------b")

    // Connector_Punctuation
    assert_eq(s.unique(github_slug("a_ \u{203f} \u{2040} \u{2054} \u{fe33} \u{fe34} \u{fe4d} \u{fe4e} \u{fe4f} \u{ff3f}b")), "a_-\u{203f}-\u{2040}-\u{2054}-\u{fe33}-\u{fe34}-\u{fe4d}-\u{fe4e}-\u{fe4f}-\u{ff3f}b")

    // Currency_Symbol
