module sh.sysl.markdown

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.container.Map
import sysl.text.{Ascii, str_builder}
import sysl.unicode.fold

// The parts of a link: its label, its destination and its title, as a link reference definition and
// an inline link both write them -- and the definitions themselves, read off the start of a
// paragraph when it closes.
//
// Every scanner here reads a leaf's bytes from an offset and answers where what it read ends, or 0
// where it read nothing: no part of a link begins at offset 0, so 0 is free to mean "no".

/** The longest link label, in characters between the brackets; a longer one is not a label. */
private const max_label: usize = 999

/** Where the link label `[...]` at `p` ends, just past its `]`; 0 if there is none there. A label
 * holds no unescaped bracket and at most `max_label` characters.
 */
private[markdown] label_end(b: []const u8, p: usize) -> usize
    if byte_at(b, p) != u8('[') then return 0

    var i = p + 1
    var chars: usize = 0

    while i < b.len
        val c = b[i]

        if c == u8('[') then return 0
        if c == u8(']') then return i + 1

        if c == u8('\\') && byte_at(b, i + 1).is_punct() then
            i += 2
            chars += 2
        else
            i += 1
            if c < 0x80 || c >= 0xc0 then chars += 1

        if chars > max_label then return 0

    0
end label_end

/** The key a label is matched by: its text case folded, with each run of whitespace one space and
 * none at either end. `None` for a label of no characters but whitespace, or of more than
 * `max_label` characters.
 */
private[markdown] normalize_label(raw: string) -> Option[string]
    val b = raw.bytes
    var chars: usize = 0

    for c in b
        if c < 0x80 || c >= 0xc0 then chars += 1

    if chars > max_label then return None

    var out = str_builder()
    var i: usize = 0

    loop
        while i < b.len && b[i].is_space() do i += 1

        if i == b.len then break

        val word = i

        while i < b.len && !b[i].is_space() do i += 1

        if out.len > 0 then out.push(" ")

        out.push(raw[word..<i])

    if out.len == 0 then return None

    Some(fold(out.finish()))
end normalize_label

/** The definition `refs` holds for the label `raw`, written as it was in the source. */
private[markdown] lookup(refs: Map[string, LinkRef], raw: string) -> Option[LinkRef]
    normalize_label(raw) match
        Some(k) -> refs.get(k)
        None -> None

/** Past the spaces and tabs at `i`, at most one line ending, and the spaces and tabs after it. */
private spnl(b: []const u8, i: usize) -> usize
    var j = skip_blanks(b, i)

    if byte_at(b, j) == u8('\n') then j = skip_blanks(b, j + 1)

    j

private skip_blanks(b: []const u8, i: usize) -> usize
    var j = i

    while j < b.len && is_space_or_tab(b[j]) do j += 1

    j

/** Past every whitespace byte at `i`, line endings included. */
private skip_space(b: []const u8, i: usize) -> usize
    var j = i

    while j < b.len && b[j].is_space() do j += 1

    j

/** A link destination at `p`: where its text begins and ends -- inside the brackets of `<...>` --
 * and where the destination itself ends. A bare destination may be empty, nests at most 32
 * parentheses, and stops at whitespace, a control character or a `)` it did not open.
 */
private[markdown] link_dest(b: []const u8, p: usize) -> Option[(usize, usize, usize)]
    var i = p

    if byte_at(b, p) == u8('<') then
        i += 1

        while i < b.len
            val c = b[i]

            if c == u8('>') then return Some((p + 1, i, i + 1))
            if c == u8('\n') || c == u8('<') then return None

            i += if c == u8('\\') then 2 else 1

        return None

    var depth: usize = 0

    while i < b.len
        val c = b[i]

        if c == u8('\\') && byte_at(b, i + 1).is_punct() then
            i += 2
        else if c == u8('(') then
            depth += 1
            if depth > 32 then return None
            i += 1
        else if c == u8(')') then
            if depth == 0 then break
            depth -= 1
            i += 1
        else if c.is_space() || c < 0x20 || c == 0x7f then
            if i == p then return None
            break
        else
            i += 1

    if i >= b.len || depth != 0 then return None

    Some((p, i, i))
end link_dest

/** Where the link title at `p` -- in `"`, `'` or `(...)` -- ends, just past its closing mark; 0 if
 * there is none there.
 */
private[markdown] title_end(b: []const u8, p: usize) -> usize
    val open = byte_at(b, p)
    val close = if open == u8('(') then u8(')') else open

    if open != u8('"') && open != u8('\'') && open != u8('(') then return 0

    var i = p + 1

    while i < b.len
        val c = b[i]

        if c == u8('\\') && byte_at(b, i + 1).is_punct() then
            i += 2
        else if c == close then
            return i + 1
        else if c == 0 || (open == u8('(') && c == u8('(')) then
            return 0
        else
            i += 1

    0
end title_end

/** The destination, title and end of the inline link whose `(` is at `p`: `(dest "title")`, either
 * part optional, whitespace around both.
 */
private[markdown] inline_link(text: string, p: usize) -> Option[(string, string, usize)]
    val b = text.bytes
    val at = skip_space(b, p + 1)

    link_dest(b, at) match
        None -> None
        Some((ds, de, after)) ->
            val st = skip_space(b, after)
            val te = if st > after then title_end(b, st) else 0
            val close = skip_space(b, if te > 0 then te else st)

            if byte_at(b, close) != u8(')') then return None

            val title = if te > 0 then unescape(text[st + 1..<te - 1]) else ""

            Some((unescape(text[ds..<de]), title, close + 1))
end inline_link

/** Past the spaces and tabs at `i` and the line ending after them, or at the end of `b`; 0 where
 * something else follows.
 */
private line_end_at(b: []const u8, i: usize) -> usize
    val j = skip_blanks(b, i)

    if j == b.len then return j
    if b[j] == u8('\n') then return j + 1

    0

/** The link reference definition at `p` in `text`, recorded in `refs` unless its label already has
 * one; answers where it ends, past its line ending, or 0 where there is none.
 */
private ref_def(text: string, p: usize, refs: Map[string, LinkRef]) -> usize
    val b = text.bytes
    val le = label_end(b, p)

    if le == 0 || byte_at(b, le) != u8(':') then return 0

    val key = normalize_label(text[p + 1..<le - 1])

    if key.is_none() then return 0

    val (ds, de, after) = link_dest(b, spnl(b, le + 1)) match
        Some(d) -> d
        None -> return 0

    val st = spnl(b, after)
    val te = if st > after then title_end(b, st) else 0
    var end = if te > 0 then line_end_at(b, te) else 0
    var title = ""

    if end > 0 then
        title = unescape(text[st + 1..<te - 1])
    else
        end = line_end_at(b, after)
        if end == 0 then return 0

    val k = key.unwrap()

    if !refs.has(k) then refs.put(k, LinkRef(unescape(text[ds..<de]), title))

    end
end ref_def

/** A paragraph's leaf without the link reference definitions it begins with, each recorded on `d`;
 * the paragraph's span is moved to begin where its text now does. A leaf with no text left is a
 * paragraph that was nothing but definitions.
 */
private[markdown] without_refs(d: Doc, leaf: Leaf) -> Leaf
    var p: usize = 0

    loop
        val q = ref_def(leaf.text, p, d.refs)

        if q == 0 then break

        p = q

    if p == 0 then return leaf

    val segs: Buf[Seg] = buf()

    for g in leaf.segs.view()
        if g.at <= p then
            segs.truncate(0)
            segs.push(Seg(0, g.src + (p - g.at)))
        else
            segs.push(Seg(g.at - p, g.src))

    val s = d.span(leaf.node)

    d.set_span(leaf.node, Span(segs[0].src, s.end))
    Leaf(leaf.node, leaf.text[p..<leaf.text.len], segs)
end without_refs
