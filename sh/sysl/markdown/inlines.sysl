module sh.sysl.markdown

import sh.sysl.parsing.{ByteSet, Span}
import sysl.buf.{Buf, buf}
import sysl.container.{Map, map}
import sysl.math.min
import sysl.slices.contains
import sysl.text.{Ascii, StrBuilder, str_builder}

// Phase 2: a leaf's text read into inline nodes.
//
// The text is taken without the spaces, tabs and line endings at its two ends, and read left to
// right. Most bytes are text and gather into one `Text` node per run; the scan stops only at a byte
// that may begin something else:
//
// | byte | may begin |
// |---|---|
// | `\` | an escaped punctuation character, or a hard line break before a line ending |
// | `&` | a character reference |
// | `` ` `` | a code span |
// | `<` | an autolink, or raw HTML |
// | line ending | a soft or hard line break |
// | `*`, `_` | emphasis: the run goes on the delimiter list (`emphasis.sysl`) |
// | `[`, `![` | a link or an image: an opener goes on the bracket stack |
// | `]` | the end of a link's or an image's text, if what follows makes one (`links.sysl`) |
// | U+0000 | nothing: it is text, and stands for U+FFFD |
// | a byte an extension triggers on | whatever the extension reads there, before any of the above |
//
// Where nothing begins, the byte stays in the run of text. A run's `Text` holds a view of the leaf's
// text, and a fresh string only where an escape or a reference made it differ. Once the whole leaf
// is read, its delimiters are paired into emphasis.

/** The inline nodes of `leaf`, appended to its node in `d`; `triggers` is every byte an extension in
 * `exts` asks to be shown.
 */
private[markdown] inlines(d: Doc, leaf: Leaf, exts: Registry, triggers: ByteSet)
    val b = leaf.text.bytes
    var s: usize = 0
    var e = b.len

    while s < e && is_line_space(b[s]) do s += 1
    while e > s && is_line_space(b[e - 1]) do e -= 1

    var sc = Scan(d, leaf, b[0..<e], SrcMap(leaf.segs, 0), s, s, None, map(), false, [false, false, false, false], delims(), buf(), exts, triggers)

    sc.run(s)

private is_line_space(c: u8) -> bool = c == u8(' ') || c == u8('\t') || c == u8('\n')

// The scan of one leaf.
private struct Scan
    d: Doc
    leaf: Leaf
    b: []const u8               // the leaf's bytes, up to the end of its trimmed text
    m: SrcMap
    text_from: usize            // where the run of text not yet made a node begins
    raw_from: usize             // where the part of that run still read straight from the leaf begins
    built: Option[StrBuilder]   // the run so far, where an escape or a reference made it differ
    ticks: Map[usize, usize]    // a backtick run's length, and where the last run of it begins
    ticks_to_end: bool          // whether `ticks` holds every run from the first code span on
    unclosed: [4]bool           // raw HTML end markers already looked for to the end
    ds: Delims
    brackets: Buf[Bracket]      // the `[` and `![` not yet closed, innermost last
    exts: Registry
    triggers: ByteSet

    run(*self, from: usize)
        var i = from

        while i < self.b.len
            val c = self.b[i]

            if self.triggers.has(c) then
                val took = self.extension(i)

                if took > i then
                    i = took
                    continue

            if c == u8('\n') then
                i = self.line_break(i, i)
            else if c == u8('\\') then
                i = self.backslash(i)
            else if c == u8('&') then
                i = self.reference(i)
            else if c == u8('`') then
                i = self.code_span(i)
            else if c == u8('<') then
                i = self.angle(i)
            else if c == u8('*') || c == u8('_') then
                i = self.delimiter_run(i)
            else if c == u8('[') then
                i = self.open_bracket(i, i + 1, false)
            else if c == u8('!') && byte_at(self.b, i + 1) == u8('[') then
                i = self.open_bracket(i, i + 2, true)
            else if c == u8(']') then
                i = self.close_bracket(i)
            else if c == 0 then
                self.replace(i, i + 1, "\u{fffd}")
                i += 1
            else
                i += 1

        self.flush(self.b.len)
        process_emphasis(self.d, self.ds, self.exts, 1)
    end run

    // A run of `*` or `_` at `i`: a `Text` node holding it, and an entry on the delimiter list saying
    // whether it may open emphasis, close it, or both.
    delimiter_run(*self, i: usize) -> usize
        val ch = self.b[i]
        var j = i + 1

        while j < self.b.len && self.b[j] == ch do j += 1

        val (open, close) = flanking(self.b, i, j)

        self.push_run(i, j, ch, open, close, 0)
        j

    // The bytes `i..<j` as a `Text` node of their own, on the delimiter list.
    push_run(*self, i: usize, j: usize, ch: u8, open: bool, close: bool, ext: usize)
        self.flush(i)

        val start = self.m.src(i)
        val node = self.d.append_child(self.leaf.node, Text(self.leaf.text[i..<j]), Span(start, self.m.src(j)))

        self.ds.push(node, ch, j - i, open, close, ext)
        self.restart(j)

    // A `[`, or with `image` a `![`, at `i..<j`: a `Text` node holding it, and an opener on the
    // bracket stack that a later `]` may make a link of.
    open_bracket(*self, i: usize, j: usize, image: bool) -> usize
        self.flush(i)

        val start = self.m.src(i)
        val node = self.d.append_child(self.leaf.node, Text(self.leaf.text[i..<j]), Span(start, self.m.src(j)))
        val n = self.brackets.len()

        if n > 0 then self.brackets.view()[n - 1].bracket_after = true

        self.brackets.push(Bracket(node, image, true, false, self.ds.top(), j))
        self.restart(j)
        j

    // The `]` at `i`, closing the innermost opener where what follows it -- or the text between them
    // -- makes a link or an image. The nodes since the opener become its children, their emphasis is
    // paired on its own, and a link deactivates every `[` before it, links not nesting. Anywhere
    // else the `]` is text and the opener is dropped.
    close_bracket(*self, i: usize) -> usize
        val n = self.brackets.len()

        if n == 0 then return i + 1

        val o = self.brackets[n - 1]

        self.brackets.truncate(n - 1)

        if !o.active then return i + 1

        val (dest, title, end) = self.link_after(o, i) match
            Some(found) -> found
            None -> return i + 1

        self.flush(i)

        val start = self.d.span(o.node).start
        val kind = if o.image then Image(dest, title) else Link(dest, title)
        val link = self.d.append_child(self.leaf.node, kind, Span(start, self.m.src(end)))
        var k = self.d.next_sibling(o.node).unwrap()

        while k.i != link.i
            val after = self.d.next_sibling(k).unwrap()

            self.d.append_node(link, k)
            k = after

        self.d.unlink(o.node)
        process_emphasis(self.d, self.ds, self.exts, o.delims)

        if !o.image then
            val v = self.brackets.view()
            var b = v.len

            while b > 0
                b -= 1

                if !v[b].image then
                    if !v[b].active then break

                    v[b].active = false

        self.restart(end)
        end
    end close_bracket

    // What the `]` at `i` closing `o` links to, and where the link ends: an inline destination in
    // parentheses, then a reference -- full where a label follows, collapsed or shortcut where
    // the text between the brackets is the label.
    link_after(self, o: Bracket, i: usize) -> Option[(string, string, usize)]
        if byte_at(self.b, i + 1) == u8('(') then
            val inline = inline_link(self.leaf.text[0..<self.b.len], i + 1)

            if inline.is_some() then return inline

        val le = label_end(self.b, i + 1)
        val full = le > 0 && !is_blank(self.b[i + 2..<le - 1])
        val raw = if full then self.leaf.text[i + 2..<le - 1] else self.leaf.text[o.after..<i]

        if !full && o.bracket_after then return None

        lookup(self.d.refs, raw).map((r) -> (r.dest, r.title, if le > 0 then le else i + 1))
    end link_after

    // The first extension that triggers on the byte at `i` and reads something there: a node of its
    // own, or a run of delimiters paired as emphasis is. Answers where the scan goes on, or `i` where
    // every extension declined.
    extension(*self, i: usize) -> usize
        val c = self.b[i]

        for ix in 0..<self.exts.len()
            val e = self.exts.at(ix)

            if contains(e.triggers().bytes, c) then
                e.inline_match(Subject(self.leaf.text, i)) match
                    NoMatch -> ()
                    Inline(kind, n) ->
                        if n > 0 then
                            val j = i + min(n, self.b.len - i)

                            self.flush(i)

                            val start = self.m.src(i)

                            self.d.append_child(self.leaf.node, kind, Span(start, self.m.src(j)))
                            self.restart(j)
                            return j
                    Delimiters(n, open, close) ->
                        if n > 0 then
                            val j = i + min(n, self.b.len - i)

                            self.push_run(i, j, c, open, close, ix + 1)
                            return j

        i
    end extension

    // The run of text up to `to` made a `Text` node, if it holds anything.
    flush(*self, to: usize)
        if to <= self.text_from then return

        val lit = self.built match
            Some(sb) ->
                var out = sb

                out.push(self.leaf.text[self.raw_from..<to])
                out.finish()
            None -> self.leaf.text[self.text_from..<to]

        val start = self.m.src(self.text_from)

        self.d.append_child(self.leaf.node, Text(lit), Span(start, self.m.src(to)))
        self.built = None
    end flush

    // A new run of text begins at `at`.
    restart(*self, at: usize)
        self.text_from = at
        self.raw_from = at
        self.built = None

    // The bytes `from..<to` of the run of text stand for `with` instead.
    replace(*self, from: usize, to: usize, with: string)
        var sb = self.built match
            Some(b) -> b
            None -> str_builder()

        sb.push(self.leaf.text[self.raw_from..<from])
        sb.push(with)
        self.built = Some(sb)
        self.raw_from = to

    // A line ending at `i`, or a backslash at `at` followed by one: hard where the line ended with a
    // backslash or with two or more spaces, soft otherwise. The spaces before it and the spaces and
    // tabs starting the next line belong to the break.
    line_break(*self, at: usize, i: usize) -> usize
        var t = at

        if at == i then
            while t > self.raw_from && self.b[t - 1] == u8(' ') do t -= 1

        val hard = at < i || i - t >= 2

        self.flush(t)

        var j = i + 1

        while j < self.b.len && is_space_or_tab(self.b[j]) do j += 1

        val from = self.m.src(t)

        self.d.append_child(self.leaf.node, if hard then HardBreak else SoftBreak, Span(from, self.m.src(j)))
        self.restart(j)
        j
    end line_break

    // A backslash before ASCII punctuation is that character as text; before a line ending, a hard
    // break; anywhere else, a backslash.
    backslash(*self, i: usize) -> usize
        val next = byte_at(self.b, i + 1)

        if next == u8('\n') then return self.line_break(i, i + 1)

        if next.is_punct() then
            self.replace(i, i + 1, "")
            return i + 2

        i + 1

    reference(*self, i: usize) -> usize
        char_ref(self.b, i) match
            Some((t, e)) ->
                self.replace(i, e, t)
                e
            None -> i + 1

    // A code span opened by the run of backticks at `i`, closed by the next run of the same length.
    // Without one, the whole opening run is text.
    code_span(*self, i: usize) -> usize
        var j = i

        while byte_at(self.b, j) == u8('`') do j += 1

        val n = j - i

        self.closing_ticks(j, n) match
            None -> j
            Some(c) ->
                self.flush(i)

                val start = self.m.src(i)

                self.d.append_child(self.leaf.node, Code(code_text(self.leaf.text[j..<c])), Span(start, self.m.src(c + n)))
                self.restart(c + n)
                c + n
    end code_span

    // Where the first run of exactly `n` backticks at or after `from` begins. Every run passed on the
    // way is recorded, and once a search has reached the end of the leaf the record answers a later
    // one without scanning: no run of `n` begins after `from` unless the last one does.
    closing_ticks(*self, from: usize, n: usize) -> Option[usize]
        if self.ticks_to_end then
            self.ticks.get(n) match
                Some(last) -> if last < from then return None
                None -> return None

        var k = from

        while k < self.b.len
            if self.b[k] != u8('`') then
                k += 1
            else
                val s = k

                while k < self.b.len && self.b[k] == u8('`') do k += 1

                self.ticks.put(k - s, s)

                if k - s == n then return Some(s)

        self.ticks_to_end = true
        None
    end closing_ticks

    // An autolink or raw HTML beginning at the `<` at `i`; otherwise the `<` is text.
    angle(*self, i: usize) -> usize
        val uri = uri_autolink_end(self.b, i)

        if uri > 0 then return self.autolink(i, uri, "")

        val email = email_autolink_end(self.b, i)

        if email > 0 then return self.autolink(i, email, "mailto:")

        val html = raw_html_end(self.b, i, &self.unclosed)

        if html == 0 then return i + 1

        self.flush(i)

        val start = self.m.src(i)

        self.d.append_child(self.leaf.node, HtmlInline(without_nul(self.leaf.text[i..<html])), Span(start, self.m.src(html)))
        self.restart(html)
        html
    end angle

    // A link to the address between the brackets at `i` and `end - 1`, with `scheme` before it, and
    // the address as its text.
    autolink(*self, i: usize, end: usize, scheme: string) -> usize
        self.flush(i)

        val a = self.m.src(i)
        val inner_a = self.m.src(i + 1)
        val inner_b = self.m.src(end - 1)
        val text = without_nul(self.leaf.text[i + 1..<end - 1])
        val link = self.d.append_child(self.leaf.node, Link(scheme + text, ""), Span(a, self.m.src(end)))

        self.d.append_child(link, Text(text), Span(inner_a, inner_b))
        self.restart(end)
        end
    end autolink
end Scan

// A `[` or `![` waiting for its `]`.
private struct Bracket
    node: NodeId            // the `Text` node holding it
    image: bool
    active: bool            // false once a link has formed after it: links do not nest
    bracket_after: bool     // another opener came after it, so the text it closes is not a label
    delims: u32             // the delimiter list's top when it was read: the bottom of its emphasis
    after: usize            // where the text inside it begins

private is_blank(b: []const u8) -> bool
    for c in b
        if !c.is_space() then return false

    true

// A code span's text: each line ending a space, then one space taken from each end where both ends
// have one and the text is not all spaces.
private code_text(raw: string) -> string
    var s = without_nul(raw)

    if contains(s.bytes, u8('\n')) then s = spaces_for_newlines(s)

    val b = s.bytes

    if b.len >= 2 && b[0] == u8(' ') && b[b.len - 1] == u8(' ') then
        for c in b
            if c != u8(' ') then return s[1..<b.len - 1]

    s
end code_text

// `s` with every line ending a space.
private spaces_for_newlines(s: string) -> string
    val b = s.bytes
    var out = str_builder()
    var from: usize = 0

    for i in 0..<b.len
        if b[i] == u8('\n') then
            out.push(s[from..<i])
            out.push(" ")
            from = i + 1

    out.push(s[from..<b.len])
    out.finish()

// `s` with every U+0000 replaced by U+FFFD, as the spec requires of the input; a fresh string only
// where there is one.
private without_nul(s: string) -> string
    val b = s.bytes
    var has = false

    for c in b
        if c == 0 then has = true

    if !has then return s

    var out = str_builder()
    var from: usize = 0

    for i in 0..<b.len
        if b[i] == 0 then
            out.push(s[from..<i])
            out.push("\u{fffd}")
            from = i + 1

    out.push(s[from..<b.len])
    out.finish()
end without_nul

// Offsets in a leaf's text mapped to the source, for queries that never go backwards -- so that a
// whole leaf costs one pass over its segments.
private struct SrcMap
    segs: Buf[Seg]
    i: usize

    src(*self, at: usize) -> usize
        while self.i + 1 < self.segs.len() && self.segs[self.i + 1].at <= at do self.i += 1

        val g = self.segs[self.i]

        if at < g.at then g.src else g.src + (at - g.at)
