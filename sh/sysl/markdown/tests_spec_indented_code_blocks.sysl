module sh.sysl.markdown
@tests

// The CommonMark 0.31.2 spec's examples from 'Indented code blocks', each rendered and compared exactly.
// Written by tools/gen_spec_tests.py from spec/spec.json; edit that, not this.

@test("example 107")
example_107()
    assert_eq(to_html(parse("    a simple\n      indented code block\n")), "<pre><code>a simple\n  indented code block\n</code></pre>\n")

@test("example 108", ignore: "needs list items")
example_108()
    assert_eq(to_html(parse("  - foo\n\n    bar\n")), "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n")

@test("example 109", ignore: "needs list items")
example_109()
    assert_eq(to_html(parse("1.  foo\n\n    - bar\n")), "<ol>\n<li>\n<p>foo</p>\n<ul>\n<li>bar</li>\n</ul>\n</li>\n</ol>\n")

@test("example 110")
example_110()
    assert_eq(to_html(parse("    <a/>\n    *hi*\n\n    - one\n")), "<pre><code>&lt;a/&gt;\n*hi*\n\n- one\n</code></pre>\n")

@test("example 111")
example_111()
    assert_eq(to_html(parse("    chunk1\n\n    chunk2\n  \n \n \n    chunk3\n")), "<pre><code>chunk1\n\nchunk2\n\n\n\nchunk3\n</code></pre>\n")

@test("example 112")
example_112()
    assert_eq(to_html(parse("    chunk1\n      \n      chunk2\n")), "<pre><code>chunk1\n  \n  chunk2\n</code></pre>\n")

@test("example 113")
example_113()
    assert_eq(to_html(parse("Foo\n    bar\n\n")), "<p>Foo\nbar</p>\n")

@test("example 114")
example_114()
    assert_eq(to_html(parse("    foo\nbar\n")), "<pre><code>foo\n</code></pre>\n<p>bar</p>\n")

@test("example 115")
example_115()
    assert_eq(to_html(parse("# Heading\n    foo\nHeading\n------\n    foo\n----\n")), "<h1>Heading</h1>\n<pre><code>foo\n</code></pre>\n<h2>Heading</h2>\n<pre><code>foo\n</code></pre>\n<hr />\n")

@test("example 116")
example_116()
    assert_eq(to_html(parse("        foo\n    bar\n")), "<pre><code>    foo\nbar\n</code></pre>\n")

@test("example 117")
example_117()
    assert_eq(to_html(parse("\n    \n    foo\n    \n\n")), "<pre><code>foo\n</code></pre>\n")

@test("example 118")
example_118()
    assert_eq(to_html(parse("    foo  \n")), "<pre><code>foo  \n</code></pre>\n")
