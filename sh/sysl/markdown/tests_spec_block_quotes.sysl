module sh.sysl.markdown
@tests

// The CommonMark 0.31.2 spec's examples from 'Block quotes', each rendered and compared exactly.
// Written by tools/gen_spec_tests.py from spec/spec.json; edit that, not this.

@test("example 228", ignore: "the parser does not read Block quotes")
example_228()
    assert_eq(to_html(parse("> # Foo\n> bar\n> baz\n")), "<blockquote>\n<h1>Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n")

@test("example 229", ignore: "the parser does not read Block quotes")
example_229()
    assert_eq(to_html(parse("># Foo\n>bar\n> baz\n")), "<blockquote>\n<h1>Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n")

@test("example 230", ignore: "the parser does not read Block quotes")
example_230()
    assert_eq(to_html(parse("   > # Foo\n   > bar\n > baz\n")), "<blockquote>\n<h1>Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n")

@test("example 231", ignore: "the parser does not read Block quotes")
example_231()
    assert_eq(to_html(parse("    > # Foo\n    > bar\n    > baz\n")), "<pre><code>&gt; # Foo\n&gt; bar\n&gt; baz\n</code></pre>\n")

@test("example 232", ignore: "the parser does not read Block quotes")
example_232()
    assert_eq(to_html(parse("> # Foo\n> bar\nbaz\n")), "<blockquote>\n<h1>Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n")

@test("example 233", ignore: "the parser does not read Block quotes")
example_233()
    assert_eq(to_html(parse("> bar\nbaz\n> foo\n")), "<blockquote>\n<p>bar\nbaz\nfoo</p>\n</blockquote>\n")

@test("example 234", ignore: "the parser does not read Block quotes")
example_234()
    assert_eq(to_html(parse("> foo\n---\n")), "<blockquote>\n<p>foo</p>\n</blockquote>\n<hr />\n")

@test("example 235", ignore: "the parser does not read Block quotes")
example_235()
    assert_eq(to_html(parse("> - foo\n- bar\n")), "<blockquote>\n<ul>\n<li>foo</li>\n</ul>\n</blockquote>\n<ul>\n<li>bar</li>\n</ul>\n")

@test("example 236", ignore: "the parser does not read Block quotes")
example_236()
    assert_eq(to_html(parse(">     foo\n    bar\n")), "<blockquote>\n<pre><code>foo\n</code></pre>\n</blockquote>\n<pre><code>bar\n</code></pre>\n")

@test("example 237", ignore: "the parser does not read Block quotes")
example_237()
    assert_eq(to_html(parse("> ```\nfoo\n```\n")), "<blockquote>\n<pre><code></code></pre>\n</blockquote>\n<p>foo</p>\n<pre><code></code></pre>\n")

@test("example 238", ignore: "the parser does not read Block quotes")
example_238()
    assert_eq(to_html(parse("> foo\n    - bar\n")), "<blockquote>\n<p>foo\n- bar</p>\n</blockquote>\n")

@test("example 239", ignore: "the parser does not read Block quotes")
example_239()
