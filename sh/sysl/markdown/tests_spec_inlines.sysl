module sh.sysl.markdown
@tests

// The CommonMark 0.31.2 spec's examples from 'Inlines', each rendered and compared exactly.
// Written by tools/gen_spec_tests.py from spec/spec.json; edit that, not this.

@test("example 327", ignore: "the parser does not read Inlines")
example_327()
    assert_eq(to_html(parse("`hi`lo`\n")), "<p><code>hi</code>lo`</p>\n")
