@test("example 499")
example_499()
    assert_eq(to_html(parse("[link](<foo(and(bar)>)\n")), "<p><a href=\"foo(and(bar)\">link</a></p>\n")

@test("example 500")
example_500()
    assert_eq(to_html(parse("[link](foo\\)\\:)\n")), "<p><a href=\"foo):\">link</a></p>\n")

@test("example 501")
example_501()
    assert_eq(to_html(parse("[link](#fragment)\n\n[link](https://example.com#fragment)\n\n[link](https://example.com?foo=3#frag)\n")), "<p><a href=\"#fragment\">link</a></p>\n<p><a href=\"https://example.com#fragment\">link</a></p>\n<p><a href=\"https://example.com?foo=3#frag\">link</a></p>\n")

@test("example 502")
