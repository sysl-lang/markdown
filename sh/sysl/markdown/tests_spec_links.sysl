module sh.sysl.markdown
@tests

// The CommonMark 0.31.2 spec's examples from 'Links', each rendered and compared exactly.
// Written by tools/gen_spec_tests.py from spec/spec.json; edit that, not this.

@test("example 482")
example_482()
    assert_eq(to_html(parse("[link](/uri \"title\")\n")), "<p><a href=\"/uri\" title=\"title\">link</a></p>\n")

@test("example 483")
example_483()
    assert_eq(to_html(parse("[link](/uri)\n")), "<p><a href=\"/uri\">link</a></p>\n")

@test("example 484")
example_484()
    assert_eq(to_html(parse("[](./target.md)\n")), "<p><a href=\"./target.md\"></a></p>\n")

@test("example 485")
example_485()
    assert_eq(to_html(parse("[link]()\n")), "<p><a href=\"\">link</a></p>\n")

@test("example 486")
example_486()
    assert_eq(to_html(parse("[link](<>)\n")), "<p><a href=\"\">link</a></p>\n")

@test("example 487")
example_487()
    assert_eq(to_html(parse("[]()\n")), "<p><a href=\"\"></a></p>\n")

@test("example 488")
example_488()
    assert_eq(to_html(parse("[link](/my uri)\n")), "<p>[link](/my uri)</p>\n")

@test("example 489")
example_489()
    assert_eq(to_html(parse("[link](</my uri>)\n")), "<p><a href=\"/my%20uri\">link</a></p>\n")

@test("example 490")
example_490()
    assert_eq(to_html(parse("[link](foo\nbar)\n")), "<p>[link](foo\nbar)</p>\n")

@test("example 491")
example_491()
    assert_eq(to_html(parse("[link](<foo\nbar>)\n")), "<p>[link](<foo\nbar>)</p>\n")

@test("example 492")
example_492()
    assert_eq(to_html(parse("[a](<b)c>)\n")), "<p><a href=\"b)c\">a</a></p>\n")

@test("example 493")
example_493()
    assert_eq(to_html(parse("[link](<foo\\>)\n")), "<p>[link](&lt;foo&gt;)</p>\n")

@test("example 494")
example_494()
    assert_eq(to_html(parse("[a](<b)c\n[a](<b)c>\n[a](<b>c)\n")), "<p>[a](&lt;b)c\n[a](&lt;b)c&gt;\n[a](<b>c)</p>\n")

@test("example 495")
example_495()
    assert_eq(to_html(parse("[link](\\(foo\\))\n")), "<p><a href=\"(foo)\">link</a></p>\n")

@test("example 496")
example_496()
    assert_eq(to_html(parse("[link](foo(and(bar)))\n")), "<p><a href=\"foo(and(bar))\">link</a></p>\n")

@test("example 497")
example_497()
    assert_eq(to_html(parse("[link](foo(and(bar))\n")), "<p>[link](foo(and(bar))</p>\n")

@test("example 498")
example_498()
