module sh.sysl.markdown
@tests

// GitHub's spec's 'autolinks' examples (spec/gfm-spec.txt), read with gfm() and rendered with
// gfm_html(), compared exactly. Written by tools/gen_spec_tests.py; edit that, not this.

@test("gfm example 621")
gfm_example_621()
    assert_eq(to_html_with(parse_with("www.commonmark.org\n", gfm()), gfm_html()), "<p><a href=\"http://www.commonmark.org\">www.commonmark.org</a></p>\n")

@test("gfm example 622")
gfm_example_622()
    assert_eq(to_html_with(parse_with("Visit www.commonmark.org/help for more information.\n", gfm()), gfm_html()), "<p>Visit <a href=\"http://www.commonmark.org/help\">www.commonmark.org/help</a> for more information.</p>\n")

@test("gfm example 623")
gfm_example_623()
    assert_eq(to_html_with(parse_with("Visit www.commonmark.org.\n\nVisit www.commonmark.org/a.b.\n", gfm()), gfm_html()), "<p>Visit <a href=\"http://www.commonmark.org\">www.commonmark.org</a>.</p>\n<p>Visit <a href=\"http://www.commonmark.org/a.b\">www.commonmark.org/a.b</a>.</p>\n")

@test("gfm example 624")
gfm_example_624()
    assert_eq(to_html_with(parse_with("www.google.com/search?q=Markup+(business)\n\nwww.google.com/search?q=Markup+(business)))\n\n(www.google.com/search?q=Markup+(business))\n\n(www.google.com/search?q=Markup+(business)\n", gfm()), gfm_html()), "<p><a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a></p>\n<p><a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a>))</p>\n<p>(<a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a>)</p>\n<p>(<a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a></p>\n")

@test("gfm example 625")
gfm_example_625()
    assert_eq(to_html_with(parse_with("www.google.com/search?q=(business))+ok\n", gfm()), gfm_html()), "<p><a href=\"http://www.google.com/search?q=(business))+ok\">www.google.com/search?q=(business))+ok</a></p>\n")

@test("gfm example 626")
gfm_example_626()
    assert_eq(to_html_with(parse_with("www.google.com/search?q=commonmark&hl=en\n\nwww.google.com/search?q=commonmark&hl;\n", gfm()), gfm_html()), "<p><a href=\"http://www.google.com/search?q=commonmark&amp;hl=en\">www.google.com/search?q=commonmark&amp;hl=en</a></p>\n<p><a href=\"http://www.google.com/search?q=commonmark\">www.google.com/search?q=commonmark</a>&amp;hl;</p>\n")

@test("gfm example 627")
gfm_example_627()
    assert_eq(to_html_with(parse_with("www.commonmark.org/he<lp\n", gfm()), gfm_html()), "<p><a href=\"http://www.commonmark.org/he\">www.commonmark.org/he</a>&lt;lp</p>\n")

@test("gfm example 628")
gfm_example_628()
    assert_eq(to_html_with(parse_with("http://commonmark.org\n\n(Visit https://encrypted.google.com/search?q=Markup+(business))\n\nAnonymous FTP is available at ftp://foo.bar.baz.\n", gfm()), gfm_html()), "<p><a href=\"http://commonmark.org\">http://commonmark.org</a></p>\n<p>(Visit <a href=\"https://encrypted.google.com/search?q=Markup+(business)\">https://encrypted.google.com/search?q=Markup+(business)</a>)</p>\n<p>Anonymous FTP is available at <a href=\"ftp://foo.bar.baz\">ftp://foo.bar.baz</a>.</p>\n")

@test("gfm example 629")
gfm_example_629()
    assert_eq(to_html_with(parse_with("foo@bar.baz\n", gfm()), gfm_html()), "<p><a href=\"mailto:foo@bar.baz\">foo@bar.baz</a></p>\n")

@test("gfm example 630")
gfm_example_630()
    assert_eq(to_html_with(parse_with("hello@mail+xyz.example isn't valid, but hello+xyz@mail.example is.\n", gfm()), gfm_html()), "<p>hello@mail+xyz.example isn't valid, but <a href=\"mailto:hello+xyz@mail.example\">hello+xyz@mail.example</a> is.</p>\n")

@test("gfm example 631")
gfm_example_631()
    assert_eq(to_html_with(parse_with("a.b-c_d@a.b\n\na.b-c_d@a.b.\n\na.b-c_d@a.b-\n\na.b-c_d@a.b_\n", gfm()), gfm_html()), "<p><a href=\"mailto:a.b-c_d@a.b\">a.b-c_d@a.b</a></p>\n<p><a href=\"mailto:a.b-c_d@a.b\">a.b-c_d@a.b</a>.</p>\n<p>a.b-c_d@a.b-</p>\n<p>a.b-c_d@a.b_</p>\n")
