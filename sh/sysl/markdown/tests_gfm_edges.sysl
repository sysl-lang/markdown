tables_60()
    assert_eq(gfm_of("aaa\n|-|\n| a |\n|-|\n"), "<table>\n<thead>\n<tr>\n<th>aaa</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>a</td>\n</tr>\n<tr>\n<td>-</td>\n</tr>\n</tbody>\n</table>\n")

