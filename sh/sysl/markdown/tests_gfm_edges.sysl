    assert_eq(gfm_of("1. [x] a\n2) [ ] b\n"), "<ol>\n<li><input type=\"checkbox\" checked=\"\" disabled=\"\" /> a</li>\n</ol>\n<ol start=\"2\">\n<li><input type=\"checkbox\" disabled=\"\" /> b</li>\n</ol>\n")

@test("task lists as cmark-gfm reads them, 5")
