task_lists_6()
    assert_eq(gfm_of("- a\n  - [ ] b\n"), "<ul>\n<li>a\n<ul>\n<li><input type=\"checkbox\" disabled=\"\" /> b</li>\n</ul>\n</li>\n</ul>\n")

@test("task lists as cmark-gfm reads them, 7")
