    assert_eq(gfm_of("- [ ] a\n- [ ]  b\n- [ ]\tc\n"), "<ul>\n<li><input type=\"checkbox\" disabled=\"\" /> a</li>\n<li><input type=\"checkbox\" disabled=\"\" /> b</li>\n<li><input type=\"checkbox\" disabled=\"\" /> c</li>\n</ul>\n")

