@test("strikethrough as cmark-gfm reads them, 19")
strikethrough_19()
    assert_eq(gfm_of("*www.a.com* _www.b.com_ ~www.c.com~ (www.d.com) xwww.e.com\n"), "<p><em><a href=\"http://www.a.com\">www.a.com</a></em> <em>www.b.com</em> <del><a href=\"http://www.c.com\">www.c.com</a></del> (<a href=\"http://www.d.com\">www.d.com</a>) xwww.e.com</p>\n")

@test("strikethrough as cmark-gfm reads them, 20")
strikethrough_20()
    assert_eq(gfm_of("a ~~b\n\nc~~ d\n"), "<p>a ~~b</p>\n<p>c~~ d</p>\n")

@test("strikethrough as cmark-gfm reads them, 21")
strikethrough_21()
    assert_eq(gfm_of("~~~a\n"), "<pre><code class=\"language-a\"></code></pre>\n")

@test("strikethrough as cmark-gfm reads them, 22")
strikethrough_22()
    assert_eq(gfm_of("~~~\ncode\n~~~\n"), "<pre><code>code\n</code></pre>\n")

@test("strikethrough as cmark-gfm reads them, 23")
strikethrough_23()
    assert_eq(gfm_of("~~a\\~~\n"), "<p>~~a~~</p>\n")

@test("strikethrough as cmark-gfm reads them, 24")
strikethrough_24()
    assert_eq(gfm_of("~a~~b~~c~\n"), "<p><del>a<del>b</del>c</del></p>\n")

@test("strikethrough as cmark-gfm reads them, 25")
strikethrough_25()
    assert_eq(gfm_of("*~a~* ~*a*~\n"), "<p><em><del>a</del></em> <del><em>a</em></del></p>\n")

@test("strikethrough as cmark-gfm reads them, 26")
strikethrough_26()
    assert_eq(gfm_of("~~a~~~~b~~\n"), "<p><del>a~~~~b</del></p>\n")

@test("strikethrough as cmark-gfm reads them, 27")
strikethrough_27()
    assert_eq(gfm_of("~~a~~ ~~~~b~~~~\n"), "<p><del>a</del> ~~~~b~~~~</p>\n")

@test("task lists as cmark-gfm reads them, 1")
task_lists_1()
    assert_eq(gfm_of("- [ ] a\n- [x] b\n- [X] c\n"), "<ul>\n<li><input type=\"checkbox\" disabled=\"\" /> a</li>\n<li><input type=\"checkbox\" checked=\"\" disabled=\"\" /> b</li>\n<li><input type=\"checkbox\" checked=\"\" disabled=\"\" /> c</li>\n</ul>\n")

@test("task lists as cmark-gfm reads them, 2")
task_lists_2()
    assert_eq(gfm_of("- [ ]\n- [x]\n"), "<ul>\n<li>[ ]</li>\n<li>[x]</li>\n</ul>\n")

@test("task lists as cmark-gfm reads them, 3")
task_lists_3()
    assert_eq(gfm_of("- [ ] \n"), "<ul>\n<li><input type=\"checkbox\" disabled=\"\" /> </li>\n</ul>\n")

@test("task lists as cmark-gfm reads them, 4")
