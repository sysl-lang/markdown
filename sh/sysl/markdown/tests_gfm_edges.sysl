@test("tables as cmark-gfm reads them, 63")
tables_63()
    assert_eq(gfm_of("~~a~~\n| ~~b~~ |\n|-|\n| ~c~ |\n"), "<p><del>a</del></p>\n<table>\n<thead>\n<tr>\n<th><del>b</del></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><del>c</del></td>\n</tr>\n</tbody>\n</table>\n")

@test("strikethrough as cmark-gfm reads them, 1")
strikethrough_1()
    assert_eq(gfm_of("~~a~~ ~b~ ~~~c~~~\n"), "<p><del>a</del> <del>b</del> ~~~c~~~</p>\n")

@test("strikethrough as cmark-gfm reads them, 2")
strikethrough_2()
    assert_eq(gfm_of("~a~~ ~~b~\n"), "<p>~a~~ ~~b~</p>\n")

@test("strikethrough as cmark-gfm reads them, 3")
strikethrough_3()
    assert_eq(gfm_of("~~a~b~~\n"), "<p><del>a~b</del></p>\n")

@test("strikethrough as cmark-gfm reads them, 4")
