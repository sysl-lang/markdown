module sh.sysl.markdown
@tests

// Hostile and corner-case inputs for the GitHub extensions, each read with gfm() and rendered with
// gfm_html(). The expected HTML is cmark-gfm 0.29.0.gfm.13's for the same input, run as
// `cmark-gfm --unsafe -e table -e strikethrough -e autolink -e tasklist -e tagfilter` -- the second
// oracle, which reads what nobody wrote a spec example for. Where the two disagree, the case is in
// tests_gfm_deviations.sysl instead.

private gfm_of(src: string) -> string = to_html_with(parse_with(src, gfm()), gfm_html())

@test("tables as cmark-gfm reads them, 1")
tables_1()
    assert_eq(gfm_of("| a |\n| - | - |\n| b |\n| - |\n"), "<p>| a |\n| - | - |\n| b |\n| - |</p>\n")

@test("tables as cmark-gfm reads them, 2")
tables_2()
    assert_eq(gfm_of("a\n-|-\n"), "<p>a\n-|-</p>\n")

@test("tables as cmark-gfm reads them, 3")
tables_3()
    assert_eq(gfm_of("a|b\n-|-\n"), "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n</table>\n")

@test("tables as cmark-gfm reads them, 4")
tables_4()
    assert_eq(gfm_of("p1\np2 \\| q\n| a | b |\n|---|---|\n| c | d |\n"), "<p>p1\np2 | q</p>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>c</td>\n<td>d</td>\n</tr>\n</tbody>\n</table>\n")

@test("tables as cmark-gfm reads them, 5")
tables_5()
    assert_eq(gfm_of("| a | b |\n|---|---|\n| c |\n| d | e | f |\n"), "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>c</td>\n<td></td>\n</tr>\n<tr>\n<td>d</td>\n<td>e</td>\n</tr>\n</tbody>\n</table>\n")

@test("tables as cmark-gfm reads them, 6")
tables_6()
    assert_eq(gfm_of("| a |\n|---|\n|\n"), "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<p>|</p>\n")

@test("tables as cmark-gfm reads them, 7")
tables_7()
    assert_eq(gfm_of("| a |\n|---|\n> q\n"), "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<blockquote>\n<p>q</p>\n</blockquote>\n")

@test("tables as cmark-gfm reads them, 8")
tables_8()
    assert_eq(gfm_of("| a |\n|---|\n- item\n"), "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<ul>\n<li>item</li>\n</ul>\n")

@test("tables as cmark-gfm reads them, 9")
tables_9()
    assert_eq(gfm_of("| a |\n|---|\n    code\n"), "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<pre><code>code\n</code></pre>\n")

@test("tables as cmark-gfm reads them, 10")
tables_10()
    assert_eq(gfm_of("| a |\n|---|\n# h\n"), "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<h1>h</h1>\n")

