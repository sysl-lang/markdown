task_lists_13()
    assert_eq(gfm_of("- [ ] [x] a\n"), "<ul>\n<li><input type=\"checkbox\" checked=\"\" disabled=\"\" /> [x] a</li>\n</ul>\n")

@test("task lists as cmark-gfm reads them, 14")
task_lists_14()
    assert_eq(gfm_of("10. [ ] a\n"), "<ol start=\"10\">\n<li><input type=\"checkbox\" disabled=\"\" /> a</li>\n</ol>\n")

@test("task lists as cmark-gfm reads them, 15")
task_lists_15()
    assert_eq(gfm_of("- \t[ ] a\n"), "<ul>\n<li><input type=\"checkbox\" disabled=\"\" /> a</li>\n</ul>\n")

@test("task lists as cmark-gfm reads them, 16")
task_lists_16()
    assert_eq(gfm_of("  - [x] a\n"), "<ul>\n<li><input type=\"checkbox\" checked=\"\" disabled=\"\" /> a</li>\n</ul>\n")

@test("task lists as cmark-gfm reads them, 17")
task_lists_17()
    assert_eq(gfm_of("- [ ] a\n\n- [ ] b\n"), "<ul>\n<li><input type=\"checkbox\" disabled=\"\" /> \n<p>a</p>\n</li>\n<li><input type=\"checkbox\" disabled=\"\" /> \n<p>b</p>\n</li>\n</ul>\n")

