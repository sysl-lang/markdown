task_lists_24()
    assert_eq(gfm_of("* [ ] a\n  * [x] b\n    * [ ] c\n"), "<ul>\n<li><input type=\"checkbox\" disabled=\"\" /> a\n<ul>\n<li><input type=\"checkbox\" checked=\"\" disabled=\"\" /> b\n<ul>\n<li><input type=\"checkbox\" disabled=\"\" /> c</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n")

