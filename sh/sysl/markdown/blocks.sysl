module sh.sysl.markdown

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.text.{StrBuilder, str_builder}

// Phase 1: the block structure, read in one pass over the lines -- the spec appendix's "A parsing
// strategy", as cmark and commonmark.js implement it.
//
// The parser keeps a stack of open blocks, the document at the bottom and the tip on top. For each
// line it does three things:
//
// 1. **Continuation.** Each open block below the document, from the bottom up, takes its prefix from
//    the line or does not. The first that does not stops the walk; the blocks above it are
//    *unmatched*, but are not closed yet, because the line may still be a lazy continuation.
// 2. **Block starts.** Unless the last matched block is a leaf that reads its lines verbatim, the
//    starters are tried in the spec's order -- block quote, ATX heading, code fence, HTML block,
//    setext underline (only on a paragraph that took the line), thematic break, list item, indented
//    code (never while a paragraph is open) -- then each extension's `block_start`. A start closes
//    the unmatched blocks and opens under the last block that may hold it; a container that opens is
//    tried again for starts inside it.
// 3. **The rest of the line.** If nothing started, a paragraph is the tip, and the line is not
//    blank, the line is a lazy continuation of that paragraph and the unmatched blocks stay open.
//    Otherwise they close, and the rest goes to the tip if it takes lines, or opens a paragraph.
//
// **A leaf's lines are gathered into one string as they arrive**, with a map from offsets in it back
// to the source; phase 2 reads it once every block is closed.
//
// **Whether a list is tight is decided by blank lines, recorded per node as cmark records them.** A
// blank line marks the block it ended in, and that block's last child; any other line clears the
// mark on every open block. A list is loose when an item that is not the last carries the mark, or
// when a child of an item ends with one and something follows it in the list. "Ends with one" looks
// through a nested list or item to its last descendant, which `tail` holds once that list or item
// closes, so the question costs no walk.

/** What an open block is, as far as the parser's own steps need to know. */
private enum Block
    Root
    Quote
    ListBlock(ordered: bool, mark: u8)          // a list: numbered or not, and its bullet or delimiter
    ItemBlock(need: usize, line: usize)         // a list item: the indent a line needs to stay in it, and the line it opened on
    Para
    Indented                                    // an indented code block
    Fenced(mark: u8, len: usize, indent: usize) // a fenced code block: its fence, and the columns before it
    Html(cond: u8)                              // an HTML block, by the start condition that opened it
    Ext(ix: usize, state: u64, shape: Shape)    // an extension's, by its place in the registry

/** How an extension's open block takes lines: `BlockStart`'s three ways of opening one. */
private enum Shape
    Verbatim        // a leaf no block starts inside, as a code block
    Holds           // a container of blocks
    Prose           // a leaf that takes lines as a paragraph does, ended by any block that starts

private struct Open
    node: NodeId
    block: Block
    end: usize          // where the last line this block took ends in the source

/** A run of a leaf's text that is contiguous in the source: its offset in the text, and in the source. */
private[markdown] struct Seg
    at: usize
    src: usize

/** A leaf waiting for phase 2: its node, its raw text, and where that text came from. */
private[markdown] struct Leaf
    node: NodeId
    text: string
    segs: Buf[Seg]

/** What a block starter did with the line. */
private enum Started
    Nothing
    Opened(leaf: bool)      // a block opened and is now the tip
    Took                    // a leaf opened, took the rest of the line, and stays open
    Done                    // a block took the rest of the line and is already closed

/** What an open block made of the line's prefix. */
private enum Step
    Match
    Fail
    Finished            // the block took the whole line and closes with it

private[markdown] struct Parser
    private doc: Doc
    private exts: Registry
    private stack: Buf[Open]
    private leaves: Buf[Leaf]
    private content: StrBuilder         // the tip leaf's text so far
    private segs: Buf[Seg]              // and its map back to the source
    private cur: Cursor
    private line: usize                 // the number of the line being read, from 1
    private blank: Buf[bool]            // per node: the last line it saw was blank
    private marked: usize               // no open block at or past this place on the stack is marked blank
    private tail: Buf[u32]              // per node: whose mark says whether it ends with a blank line
    private blank_list: Buf[bool]       // per list: the last line to reach it was blank
    private para_words: Buf[u64]        // per extension: what it kept with the open paragraph

    /** Read one line: `text`, beginning at `start` in the source. */
    process(*self, text: string, start: usize)
        self.cur = cursor(text, start)
        self.line += 1

        val line_end = start + text.len
        var last: usize = 0
        var going = true

        while going && last + 1 < self.stack.len()
            self.cur.find_next_nonspace()

            if self.blank_again(last + 1) then
                self.reach(last + 1, line_end)

                if self.takes_lines(self.stack.len() - 1) then
                    self.reach(self.stack.len(), line_end)
                    self.add_line()

                return

            self.step(last + 1) match
                Match -> last += 1
                Fail -> going = false
                Finished ->
                    self.reach(last + 2, line_end)
                    self.close_to(last + 1)
                    return

        self.reach(last + 1, line_end)

        var closed = last + 1 == self.stack.len()
        var container = last

        while !self.reads_verbatim(container)
            self.cur.find_next_nonspace()

            self.start(container) match
                Done | Took ->
                    self.mark_blank(self.stack.len() - 1)
                    return
                Nothing ->
                    self.cur.advance_next_nonspace()
                    break
                Opened(leaf) ->
                    container = self.stack.len() - 1
                    closed = true
                    if leaf then break

        if !closed && !self.cur.blank && self.is_para(self.stack.len() - 1) then
            self.reach(self.stack.len(), line_end)
            self.mark_blank(self.stack.len() - 1)
            self.add_line()
        else
            self.close_to(container + 1)
            self.mark_blank(container)

            if self.takes_lines(container) then
                val ends = self.html_ends(container)

                self.add_line()
                if ends then self.close_to(container)
            else if !self.cur.blank then
                val at = start + self.cur.offset
                val parent = self.parent_for(container)
                val para = self.doc.append_child(self.stack[parent].node, Paragraph, Span(at, line_end))

                self.stack.push(Open(para, Para, line_end))
                self.para_words.clear()
                self.add_line()
    end process

    /** A region of program lines in place of the lines it covers: every open block closes, and the
     * region becomes a code block of the document's own.
     */
    region(*self, r: Region)
        self.close_to(1)
        self.doc.append_child(self.doc.root(), CodeBlock(r.info, r.literal, false), r.span)
        self.reach(1, r.span.end)
        self.marked = 0

    /** Close every open block, then read each leaf's text into inlines. */
    finish(*self) -> Doc
        self.close_to(1)

        val triggers = self.exts.trigger_set()

        var refs_left = ref_budget(self.doc.src.len)

        for leaf in self.leaves.view() do refs_left = inlines(self.doc, leaf, self.exts, triggers, refs_left)

        for i in 0..<self.exts.len() do self.exts.at(i).post_pass(self.doc)

        self.doc

    // Whether the line is a second blank line in a row to reach the list open at `i`. The first left
    // every block under the list as a blank line leaves it -- a paragraph closed, an item with
    // content kept, an empty one closed -- so another changes nothing there but the text of a code
    // or HTML block at the tip, and the rest of the line is not stepped through: a run of blank lines
    // in a list nested thousands deep costs one step each rather than one per level. An extension's
    // block at the tip is stepped through as usual, not being known to read a blank line so.
    private blank_again(*self, i: usize) -> bool
        self.stack[i].block match
            ListBlock(_, _) ->
                val n = usize(self.stack[i].node.i)
                val tip = self.stack[self.stack.len() - 1].block match
                    Ext(_, _, _) -> false
                    _ -> true

                while self.blank_list.len() <= n do self.blank_list.push(false)

                val again = self.cur.blank && self.cur.indent == 0 && tip && self.blank_list[n]

                self.blank_list[n] = self.cur.blank
                again
            _ -> false
    end blank_again

    // Whether the open block at `i` takes the current line's prefix.
    private step(*self, i: usize) -> Step
        val o = self.stack[i]

        o.block match
            Root | ListBlock(_, _) -> Match
            Quote ->
                if self.cur.indent > 3 || self.cur.at(self.cur.next_nonspace) != u8('>') then return Fail

                self.cur.advance(self.cur.indent + 1, true)
                if is_space_or_tab(self.cur.at(self.cur.offset)) then self.cur.advance(1, true)
                Match
            ItemBlock(need, _) ->
                if self.cur.indent >= need then
                    self.cur.advance(need, true)
                    Match
                else if self.cur.blank && self.doc.first_child(o.node).is_some() then
                    self.cur.advance_next_nonspace()
                    Match
                else
                    Fail
            Para -> if self.cur.blank then Fail else Match
            Indented ->
                if self.cur.indent >= 4 then
                    self.cur.advance(4, true)
                    Match
                else if self.cur.blank then
                    self.cur.advance_next_nonspace()
                    Match
                else
                    Fail
            Fenced(mark, len, indent) ->
                if self.cur.indent < 4 && closes_fence(self.cur, mark, len) then return Finished

                var left = indent

                while left > 0 && is_space_or_tab(self.cur.at(self.cur.offset))
                    self.cur.advance(1, true)
                    left -= 1

                Match
            Html(cond) -> if self.cur.blank && cond >= 6 then Fail else Match
            Ext(ix, state, shape) ->
                var word = state
                val line = self.cur.line(self.doc.kind(self.stack[i - 1].node), "".bytes, 0)
                val answer = self.exts.at(ix).block_continue(line, self.doc.kind(o.node), &word)

                self.stack.view()[i].block = Ext(ix, word, shape)

                answer match
                    Takes(n) ->
                        self.cur.advance(n, false)
                        Match
                    Ends -> Fail
                    Finishes -> Finished
    end step

    // The block starters, in the spec's order, and then the extensions'.
    private start(*self, container: usize) -> Started
        val c = self.cur
        val p = c.next_nonspace
        val in_para = self.is_para(self.stack.len() - 1)
        val line_end = c.start + c.text.len

        if c.indent < 4 then
            if c.at(p) == u8('>') then
                val parent = self.parent_for(container)
                val node = self.doc.append_child(self.stack[parent].node, BlockQuote, Span(c.start + p, line_end))

                self.cur.advance(p + 1 - c.offset, false)
                if is_space_or_tab(self.cur.at(self.cur.offset)) then self.cur.advance(1, true)

                self.stack.push(Open(node, Quote, line_end))
                return Opened(false)

            val level = atx_level(c, p)

            if level > 0 then
                self.atx(container, p, level)
                return Done

            val fence = fence_len(c, p)

            if fence > 0 then return self.fence(container, p, fence)

            val cond = html_block_start(c.text.bytes, p, in_para)

            if cond > 0 then
                val parent = self.parent_for(container)
                val node = self.doc.append_child(self.stack[parent].node, HtmlBlock(""), Span(c.start + c.offset, line_end))

                self.stack.push(Open(node, Html(cond), line_end))
                return Opened(true)

            if self.is_para(container) then
                val under = setext_level(c, p)

                if under > 0 && self.keeps_text_past_refs(container) then
                    self.doc.set_kind(self.stack[container].node, Heading(under, None))
                    self.close_to(container)
                    return Done

            if p >= c.no_break_before then
                val stop = break_stop(c, p)

                if stop == 0 then
                    val parent = self.parent_for(container)

                    self.doc.append_child(self.stack[parent].node, ThematicBreak, Span(c.start + p, line_end))
                    return Done

                self.cur.no_break_before = stop

            val m = list_marker(c, p, self.is_para(container))

            if m.len > 0 then return self.item(container, m)
        else if !in_para && !c.blank then
            val parent = self.parent_for(container)
            val node = self.doc.append_child(self.stack[parent].node, CodeBlock("", "", false), Span(c.start + c.offset, line_end))

            self.cur.advance(4, true)
            self.stack.push(Open(node, Indented, line_end))
            return Opened(true)

        if self.exts.is_empty() then return Nothing

        val within = self.doc.kind(self.stack[container].node)
        val in_this = self.is_para(container)
        val para = if in_this then self.content.bytes.view() else "".bytes

        while self.para_words.len() < self.exts.len() do self.para_words.push(0)

        for ix in 0..<self.exts.len()
            val e = self.exts.at(ix)

            if !in_para || e.interrupts_paragraph() then
                e.block_start(c.line(within, para, if in_this then self.para_words[ix] else 0)) match
                    Declined -> ()
                    Mark(word) -> if in_this then self.para_words[ix] = word
                    Leaf(k, n, state) -> return self.open_ext(container, ix, k, n, state, Verbatim)
                    Container(k, n, state) -> return self.open_ext(container, ix, k, n, state, Holds)
                    Lines(k, n, state, from) -> return self.open_lines(container, ix, k, n, state, from)
                    Retag(k, n) ->
                        self.doc.set_kind(self.stack[container].node, k)
                        self.cur.advance(n, false)
                        self.cur.find_next_nonspace()
                        return Nothing

        Nothing
    end start

    // An ATX heading of `level` whose `#`s begin at `p`: its text is what lies between the opening
    // sequence and an optional closing one, without the spaces and tabs around it.
    private atx(*self, container: usize, p: usize, level: usize)
        val c = self.cur
        val b = c.text.bytes
        var s = p + level
        var e = b.len

        while s < e && is_space_or_tab(b[s]) do s += 1
        while e > s && is_space_or_tab(b[e - 1]) do e -= 1

        var h = e

        while h > s && b[h - 1] == u8('#') do h -= 1

        if h == s then
            e = s
        else if h < e && is_space_or_tab(b[h - 1]) then
            e = h
            while e > s && is_space_or_tab(b[e - 1]) do e -= 1

        val parent = self.parent_for(container)
        val node = self.doc.append_child(self.stack[parent].node, Heading(u8(level), None), Span(c.start + p, c.start + b.len))
        var segs: Buf[Seg] = buf()

        segs.push(Seg(0, c.start + s))
        self.leaves.push(Leaf(node, c.text[s..<e], segs))
    end atx

    // A fenced code block whose opening fence of `n` marks begins at `p`. The rest of the line is its
    // info string, without the spaces and tabs around it; no line of the content is on this one.
    private fence(*self, container: usize, p: usize, n: usize) -> Started
        val c = self.cur
        val b = c.text.bytes
        var s = p + n
        var e = b.len

        while s < e && is_space_or_tab(b[s]) do s += 1
        while e > s && is_space_or_tab(b[e - 1]) do e -= 1

        val parent = self.parent_for(container)
        val line_end = c.start + b.len
        val node = self.doc.append_child(self.stack[parent].node, CodeBlock(c.text[s..<e], "", true), Span(c.start + p, line_end))

        self.stack.push(Open(node, Fenced(b[p], n, c.indent), line_end))
        Took
    end fence

    // A list item whose marker `m` begins at the line's first non-space. The columns of space after
    // the marker, if one to four, belong to the marker and set the item's content indent; five or
    // more mean the content starts with indented code, so only one of them is the marker's, and so
    // is the one where nothing follows. The item continues an open list of the same kind of marker,
    // or opens a new list.
    private item(*self, container: usize, m: Marker) -> Started
        val p = self.cur.next_nonspace
        val offset = self.cur.indent
        val at = self.cur.start + p
        val line_end = self.cur.start + self.cur.text.len

        self.cur.advance(p + m.len - self.cur.offset, false)

        val saved = self.cur

        while self.cur.column - saved.column <= 5 && is_space_or_tab(self.cur.at(self.cur.offset))
            self.cur.advance(1, true)

        val spaces = self.cur.column - saved.column
        var padding = m.len + spaces

        if spaces >= 5 || spaces < 1 || self.cur.offset >= self.cur.text.len then
            padding = m.len + 1
            self.cur = saved
            if spaces > 0 then self.cur.advance(1, true)

        val same = self.stack[container].block match
            ListBlock(ordered, mark) -> ordered == m.ordered && mark == m.mark
            _ -> false

        var list = container

        if same then
            self.close_to(container + 1)
        else
            val parent = self.parent_for(container)
            val kind = if m.ordered then Ordered(m.start, m.mark) else Bullet(m.mark)
            val node = self.doc.append_child(self.stack[parent].node, List(kind, true), Span(at, line_end))

            self.stack.push(Open(node, ListBlock(m.ordered, m.mark), line_end))
            list = self.stack.len() - 1

        val node = self.doc.append_child(self.stack[list].node, Item(None), Span(at, line_end))

        self.stack.push(Open(node, ItemBlock(offset + padding, self.line), line_end))
        Opened(false)
    end item

    private open_ext(*self, container: usize, ix: usize, k: Kind, n: usize, state: u64, shape: Shape) -> Started
        val parent = self.parent_for(container)
        val node = self.doc.append_child(self.stack[parent].node, k, Span(self.cur.start + self.cur.offset, self.cur.start + self.cur.text.len))

        self.cur.advance(n, false)
        self.stack.push(Open(node, Ext(ix, state, shape), self.cur.start + self.cur.text.len))
        Opened(shape != Holds)

    // An extension's leaf that takes lines as a paragraph does, its first lines the last `from_para`
    // of the paragraph open at `container`, which keeps the rest -- their text, their map back to
    // the source, and an end at the last line it kept.
    private open_lines(*self, container: usize, ix: usize, k: Kind, n: usize, state: u64, from_para: usize) -> Started
        val line_end = self.cur.start + self.cur.text.len
        var start = self.cur.start + self.cur.offset
        var taken = ""
        var taken_segs: Buf[Seg] = buf()

        if from_para > 0 && self.is_para(container) then
            val leaf = self.take_leaf(self.stack[container].node)
            val b = leaf.text.bytes
            var cut = b.len
            var left = from_para

            while left > 0 && cut > 0
                cut -= 1
                while cut > 0 && b[cut - 1] != u8('\n') do cut -= 1
                left -= 1

            for s in leaf.segs.view()
                if s.at < cut then self.segs.push(s) else if s.at > cut then taken_segs.push(Seg(s.at - cut, s.src))

            start = src_of(leaf.segs, cut)
            taken_segs.insert(0, Seg(0, start))
            self.content.push(leaf.text[0..<cut])
            taken = leaf.text[cut..<b.len]

            if cut > 0 then self.stack.view()[container].end = src_of(leaf.segs, cut - 1)

        val parent = self.parent_for(container)
        val node = self.doc.append_child(self.stack[parent].node, k, Span(start, line_end))

        self.cur.advance(n, false)
        self.stack.push(Open(node, Ext(ix, state, Prose), line_end))
        self.content.push(taken)
        self.segs = taken_segs
        Opened(true)
    end open_lines

    // The nearest open block at or below `container` that may hold a new block, with everything
    // above it closed: a paragraph is closed by any block that starts while it is open.
    private parent_for(*self, container: usize) -> usize
        var p = container

        while !self.holds_blocks(p) do p -= 1

        self.close_to(p + 1)
        p

    // The rest of the line, appended to the tip leaf's text. The columns left of a tab only partly
    // consumed by a container's prefix become spaces.
    private add_line(*self)
        if self.cur.partial then
            val n = 4 - self.cur.column % 4

            self.cur.offset += 1
            for _ in 0..<n do self.content.push(" ")

        val c = self.cur

        self.segs.push(Seg(self.content.len, c.start + c.offset))
        self.content.push(c.text[c.offset..<c.text.len])
        self.content.push("\n")
    end add_line

    // Record that the blocks below `n` on the stack reach to `end`. Only the deepest of them is
    // written: a block passes its end down to the one below it when it closes (`close_top`), so a
    // line costs the same however deep the blocks it reaches are nested.
    private reach(*self, n: usize, end: usize)
        if n > 0 then self.stack.view()[n - 1].end = end

    // Close open blocks until `n` are left.
    private close_to(*self, n: usize)
        while self.stack.len() > n do self.close_top()

    private close_top(*self)
        val o = self.stack[self.stack.len() - 1]

        self.stack.truncate(self.stack.len() - 1)
        self.doc.set_span(o.node, Span(self.doc.span(o.node).start, o.end))

        val below = self.stack.len()

        if below > 0 && self.stack[below - 1].end < o.end then self.stack.view()[below - 1].end = o.end

        o.block match
            Root | Quote -> ()
            ListBlock(_, _) ->
                self.end_with_last_child(o.node)

                val tight = self.is_tight(o.node)

                self.doc.kind(o.node) match
                    List(kind, _) -> self.doc.set_kind(o.node, List(kind, tight))
                    _ -> ()
            ItemBlock(_, _) -> self.end_with_last_child(o.node)
            Para ->
                val leaf = self.doc.kind(o.node) match
                    Paragraph -> without_refs(self.doc, self.take_leaf(o.node))
                    _ -> self.take_leaf(o.node)

                if leaf.text.len == 0 then self.doc.unlink(o.node) else self.leaves.push(leaf)
            Indented ->
                val leaf = self.take_leaf(o.node)
                val n = without_trailing_blank_lines(leaf.text)

                self.doc.set_kind(o.node, CodeBlock("", leaf.text[0..<n], false))
                self.doc.set_span(o.node, Span(self.doc.span(o.node).start, src_of(leaf.segs, n - 1)))
            Fenced(_, _, _) ->
                val text = self.take_leaf(o.node).text

                self.doc.kind(o.node) match
                    CodeBlock(info, _, _) -> self.doc.set_kind(o.node, CodeBlock(unescape(info), text, true))
                    _ -> ()
            Html(_) -> self.doc.set_kind(o.node, HtmlBlock(self.take_leaf(o.node).text))
            Ext(ix, state, shape) ->
                val leaf = if shape == Holds then Leaf(o.node, "", buf()) else self.take_leaf(o.node)
                val c = Closing(o.node, self.doc.kind(o.node), leaf.text, self.doc, leaf.segs, self.leaves)

                self.doc.set_kind(o.node, self.exts.at(ix).block_close(c, state))
    end close_top

    // The tip leaf's gathered text, leaving the parser ready to gather the next one's.
    private take_leaf(*self, node: NodeId) -> Leaf
        val leaf = Leaf(node, self.content.finish(), self.segs)

        self.content.clear()
        self.segs = buf()
        leaf

    // The link reference definitions the paragraph at `i` begins with taken out of its text, as a
    // setext underline does before the paragraph becomes a heading; whether any text is left.
    private keeps_text_past_refs(*self, i: usize) -> bool
        val leaf = without_refs(self.doc, self.take_leaf(self.stack[i].node))

        self.content.push(leaf.text)
        self.segs = leaf.segs
        leaf.text.len > 0

    private is_para(self, i: usize) -> bool
        self.stack[i].block match
            Para -> true
            _ -> false

    // A list holds only items, so it is not among the blocks that hold any block.
    private holds_blocks(self, i: usize) -> bool
        self.stack[i].block match
            Root | Quote | ItemBlock(_, _) -> true
            Ext(_, _, shape) -> shape == Holds
            _ -> false

    private takes_lines(self, i: usize) -> bool
        self.stack[i].block match
            Root | Quote | ListBlock(_, _) | ItemBlock(_, _) -> false
            Ext(_, _, shape) -> shape != Holds
            _ -> true

    // A leaf on which block starts are still tried: a paragraph, or an extension's that takes its
    // lines as one does.
    private is_prose(self, i: usize) -> bool
        self.stack[i].block match
            Para -> true
            Ext(_, _, shape) -> shape == Prose
            _ -> false

    // Record the current line against the open block at `i`, the deepest the line reached, and the
    // blocks below it. A blank line marks that block and its last child, except where a blank line
    // does not separate anything: a quote's line, which holds its `>`, a fenced code block's, and
    // the line an empty list item opened on. Any other line clears the marks.
    private mark_blank(*self, i: usize)
        val o = self.stack[i]
        val blank = self.cur.blank

        if blank then
            self.doc.last_child(o.node) match
                Some(c) -> self.set_blank(c, true)
                None -> ()

        val counts = o.block match
            Quote | Fenced(_, _, _) -> false
            ItemBlock(_, line) -> line != self.line || self.doc.first_child(o.node).is_some()
            _ -> true

        self.set_blank(o.node, blank && counts)

        for k in 0..<(if i < self.marked then i else self.marked) do self.set_blank(self.stack[k].node, false)

        self.marked = if blank && counts then i + 1 else 0
    end mark_blank

    private set_blank(*self, n: NodeId, v: bool)
        val i = usize(n.i)

        while self.blank.len() <= i do self.blank.push(false)

        self.blank[i] = v

    private blank_of(self, n: NodeId) -> bool = usize(n.i) < self.blank.len() && self.blank[usize(n.i)]

    // The node whose mark says whether `n` ends with a blank line: `n` itself, or for a list or an
    // item, the tail of its last child.
    private tail_of(self, n: NodeId) -> NodeId = if usize(n.i) < self.tail.len() then NodeId(self.tail[usize(n.i)]) else n

    // A closing list or item ends where its last child does, which leaves the blank lines after
    // that child out; an item with no children ends with its marker's line.
    private end_with_last_child(*self, n: NodeId)
        self.doc.last_child(n) match
            Some(c) ->
                self.doc.set_span(n, Span(self.doc.span(n).start, self.doc.span(c).end))

                val i = usize(n.i)
                var k = self.tail.len()

                while k <= i
                    self.tail.push(u32(k))
                    k += 1

                self.tail[i] = self.tail_of(c).i
            None -> ()
    end end_with_last_child

    // The spec's rule: a list is loose if any of its items is separated from the next by a blank
    // line, or if any item directly holds two blocks with a blank line between them.
    private is_tight(self, list: NodeId) -> bool
        var item = self.doc.first_child(list)

        loop
            item match
                None -> return true
                Some(it) ->
                    val more = self.doc.next_sibling(it).is_some()

                    if more && self.blank_of(it) then return false

                    var sub = self.doc.first_child(it)

                    loop
                        sub match
                            None -> break
                            Some(s) ->
                                val after = more || self.doc.next_sibling(s).is_some()

                                if after && self.blank_of(self.tail_of(s)) then return false

                                sub = self.doc.next_sibling(s)

                    item = self.doc.next_sibling(it)
    end is_tight

    // Whether the open block at `i` is an HTML block that the rest of the current line ends.
    private html_ends(self, i: usize) -> bool
        self.stack[i].block match
            Html(cond) -> html_block_ends(cond, self.cur.text.bytes[self.cur.offset..<self.cur.text.len])
            _ -> false

    // A leaf that takes its lines as they are, so that no block may start inside it.
    private reads_verbatim(self, i: usize) -> bool = self.takes_lines(i) && !self.is_prose(i)
end Parser

private[markdown] parser(src: string, exts: Registry) -> Parser
    var stack: Buf[Open] = buf()

    var doc = new_doc(src)

    doc.exts = exts
    stack.push(Open(NodeId(0), Root, 0))
    Parser(doc, exts, stack, buf(), str_builder(), buf(), cursor("", 0), 0, buf(), 0, buf(), buf(), buf())

/** A list item's marker: its length in bytes, and what kind of list it belongs to. */
private struct Marker
    len: usize          // zero where there is no marker
    ordered: bool
    mark: u8            // the bullet, or the delimiter after the number
    start: u32          // the number, for an ordered marker

// The list item marker at `p`: a `-`, `+` or `*`, or one to nine digits and a `.` or `)`, followed
// by a space, a tab or the end of the line. One that would interrupt a paragraph must have something
// after it, and if ordered must be `1`.
private list_marker(c: Cursor, p: usize, interrupts: bool) -> Marker
    val none = Marker(0, false, 0, 0)
    val b = c.text.bytes
    val first = c.at(p)
    var e = p
    var ordered = false
    var start: u32 = 0

    if p < b.len && (first == u8('-') || first == u8('+') || first == u8('*')) then
        e = p + 1
    else
        while e < b.len && e - p < 9 && b[e] >= u8('0') && b[e] <= u8('9')
            start = start * 10 + u32(b[e] - u8('0'))
            e += 1

        if e == p || e >= b.len || (b[e] != u8('.') && b[e] != u8(')')) then return none
        if interrupts && start != 1 then return none

        ordered = true
        e += 1

    if e < b.len && !is_space_or_tab(b[e]) then return none

    if interrupts then
        var i = e

        while i < b.len && is_space_or_tab(b[i]) do i += 1

        if i == b.len then return none

    Marker(e - p, ordered, b[e - 1], start)
end list_marker

// The level of an ATX heading opening at `p`: one to six `#`, then a space, a tab or the end of the
// line. Zero where there is none.
private atx_level(c: Cursor, p: usize) -> usize
    var n: usize = 0

    while c.at(p + n) == u8('#') do n += 1

    if n == 0 || n > 6 then return 0

    val after = c.at(p + n)

    if after == 0 && p + n < c.text.len then return 0
    if after == 0 || is_space_or_tab(after) then n else 0
end atx_level

// Zero where a thematic break is at `p` -- three or more of one of `*`, `-` and `_` to the end of the
// line, with nothing between them but spaces and tabs -- and otherwise where the scan stopped. Every
// byte the scan passed is a space, a tab or the one mark, so a scan from any of them stops at the same
// place: a line of `- - - ... x`, a list item opening at every marker, is scanned once and not once per
// item.
private break_stop(c: Cursor, p: usize) -> usize
    val b = c.text.bytes
    val mark = c.at(p)

    if mark != u8('*') && mark != u8('-') && mark != u8('_') then return p + 1

    var n: usize = 0

    for i in p..<b.len
        if b[i] == mark then
            n += 1
        else if !is_space_or_tab(b[i]) then
            return i

    if n >= 3 then 0 else b.len
end break_stop

// The length of a code fence opening at `p`: three or more backticks or tildes, where a backtick
// fence's info string may hold no backtick. Zero where there is none.
private fence_len(c: Cursor, p: usize) -> usize
    val b = c.text.bytes
    val mark = c.at(p)

    if mark != u8('`') && mark != u8('~') then return 0

    var e = p

    while e < b.len && b[e] == mark do e += 1

    if e - p < 3 then return 0

    if mark == u8('`') then
        for i in e..<b.len
            if b[i] == mark then return 0

    e - p
end fence_len

// Whether the line from its first non-space is a closing fence for a block opened by `len` of
// `mark`: at least as many of the same mark, then nothing but spaces and tabs.
private closes_fence(c: Cursor, mark: u8, len: usize) -> bool
    val b = c.text.bytes
    val p = c.next_nonspace
    var e = p

    while e < b.len && b[e] == mark do e += 1

    if e - p < len then return false

    for i in e..<b.len
        if !is_space_or_tab(b[i]) then return false

    true
end closes_fence

// The level of a setext underline at `p` -- a run of `=` for 1 or of `-` for 2, then nothing but
// spaces and tabs. Zero where the line is not one.
private setext_level(c: Cursor, p: usize) -> u8
    val b = c.text.bytes
    val mark = c.at(p)

    if mark != u8('=') && mark != u8('-') then return 0

    var e = p

    while e < b.len && b[e] == mark do e += 1

    for i in e..<b.len
        if !is_space_or_tab(b[i]) then return 0

    if mark == u8('=') then 1 else 2
end setext_level

// The length of an indented code block's text without its trailing blank lines: through the line
// ending of its last line that holds anything but spaces and tabs.
private without_trailing_blank_lines(text: string) -> usize
    val b = text.bytes
    var i = b.len

    while i > 0 && (is_space_or_tab(b[i - 1]) || b[i - 1] == u8('\n')) do i -= 1
    while i < b.len && b[i] != u8('\n') do i += 1

    if i < b.len then i + 1 else i

// Where the byte at `at` in a leaf's text came from in the source: the last run starting at or before
// it, found by halving, so that a table asking once per cell stays linear.
private[markdown] src_of(segs: Buf[Seg], at: usize) -> usize
    val g = segs[seg_at(segs, at)]

    if at < g.at then g.src else g.src + (at - g.at)

// The index of the last run that starts at or before `at`, or 0 where none does.
private[markdown] seg_at(segs: Buf[Seg], at: usize) -> usize
    var lo: usize = 0
    var hi = segs.len()

    while hi - lo > 1
        val mid = lo + (hi - lo) / 2

        if segs[mid].at <= at then lo = mid else hi = mid

    lo
