module sh.sysl.markdown
@tests

// The CommonMark 0.31.2 spec's examples from 'Fenced code blocks', each rendered and compared exactly.
// Written by tools/gen_spec_tests.py from spec/spec.json; edit that, not this.

@test("example 119", ignore: "the parser does not read Fenced code blocks")
example_119()
    assert_eq(to_html(parse("```\n<\n >\n```\n")), "<pre><code>&lt;\n &gt;\n</code></pre>\n")

@test("example 120", ignore: "the parser does not read Fenced code blocks")
example_120()
    assert_eq(to_html(parse("~~~\n<\n >\n~~~\n")), "<pre><code>&lt;\n &gt;\n</code></pre>\n")

@test("example 121", ignore: "the parser does not read Fenced code blocks")
example_121()
    assert_eq(to_html(parse("``\nfoo\n``\n")), "<p><code>foo</code></p>\n")

@test("example 122", ignore: "the parser does not read Fenced code blocks")
example_122()
    assert_eq(to_html(parse("```\naaa\n~~~\n```\n")), "<pre><code>aaa\n~~~\n</code></pre>\n")

