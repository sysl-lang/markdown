module sh.sysl.markdown
@tests

// The CommonMark 0.31.2 spec's examples from 'List items', each rendered and compared exactly.
// Written by tools/gen_spec_tests.py from spec/spec.json; edit that, not this.

@test("example 253", ignore: "the parser does not read List items")
example_253()
    assert_eq(to_html(parse("A paragraph\nwith two lines.\n\n    indented code\n\n> A block quote.\n")), "<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n")

@test("example 254", ignore: "the parser does not read List items")
example_254()
    assert_eq(to_html(parse("1.  A paragraph\n    with two lines.\n\n        indented code\n\n    > A block quote.\n")), "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>\n")

@test("example 255", ignore: "the parser does not read List items")
example_255()
    assert_eq(to_html(parse("- one\n\n two\n")), "<ul>\n<li>one</li>\n</ul>\n<p>two</p>\n")

@test("example 256", ignore: "the parser does not read List items")
example_256()
    assert_eq(to_html(parse("- one\n\n  two\n")), "<ul>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ul>\n")

@test("example 257", ignore: "the parser does not read List items")
example_257()
    assert_eq(to_html(parse(" -    one\n\n     two\n")), "<ul>\n<li>one</li>\n</ul>\n<pre><code> two\n</code></pre>\n")

@test("example 258", ignore: "the parser does not read List items")
example_258()
    assert_eq(to_html(parse(" -    one\n\n      two\n")), "<ul>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ul>\n")

@test("example 259", ignore: "the parser does not read List items")
example_259()
    assert_eq(to_html(parse("   > > 1.  one\n>>\n>>     two\n")), "<blockquote>\n<blockquote>\n<ol>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ol>\n</blockquote>\n</blockquote>\n")

@test("example 260", ignore: "the parser does not read List items")
example_260()
    assert_eq(to_html(parse(">>- one\n>>\n  >  > two\n")), "<blockquote>\n<blockquote>\n<ul>\n<li>one</li>\n</ul>\n<p>two</p>\n</blockquote>\n</blockquote>\n")

@test("example 261", ignore: "the parser does not read List items")
example_261()
    assert_eq(to_html(parse("-one\n\n2.two\n")), "<p>-one</p>\n<p>2.two</p>\n")

@test("example 262", ignore: "the parser does not read List items")
example_262()
    assert_eq(to_html(parse("- foo\n\n\n  bar\n")), "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n")

@test("example 263", ignore: "the parser does not read List items")
example_263()
    assert_eq(to_html(parse("1.  foo\n\n    ```\n    bar\n    ```\n\n    baz\n\n    > bam\n")), "<ol>\n<li>\n<p>foo</p>\n<pre><code>bar\n</code></pre>\n<p>baz</p>\n<blockquote>\n<p>bam</p>\n</blockquote>\n</li>\n</ol>\n")

@test("example 264", ignore: "the parser does not read List items")
