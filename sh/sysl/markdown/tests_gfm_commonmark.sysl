module sh.sysl.markdown
@tests

// The CommonMark 0.31.2 spec's examples read with every GitHub extension on: each renders as the
// spec says, but for the few an extension changes, which assert what cmark-gfm renders with the
// same extensions. Written by tools/gen_spec_tests.py from spec/spec.json; edit that, not this.

@test("example 1 with the GitHub extensions")
gfm_commonmark_1()
    assert_eq(to_html_with(parse_with("\tfoo\tbaz\t\tbim\n", gfm()), gfm_html()), "<pre><code>foo\tbaz\t\tbim\n</code></pre>\n")

@test("example 2 with the GitHub extensions")
gfm_commonmark_2()
    assert_eq(to_html_with(parse_with("  \tfoo\tbaz\t\tbim\n", gfm()), gfm_html()), "<pre><code>foo\tbaz\t\tbim\n</code></pre>\n")

@test("example 3 with the GitHub extensions")
gfm_commonmark_3()
    assert_eq(to_html_with(parse_with("    a\ta\n    \u{1f50}\ta\n", gfm()), gfm_html()), "<pre><code>a\ta\n\u{1f50}\ta\n</code></pre>\n")

@test("example 4 with the GitHub extensions")
gfm_commonmark_4()
    assert_eq(to_html_with(parse_with("  - foo\n\n\tbar\n", gfm()), gfm_html()), "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n")

@test("example 5 with the GitHub extensions")
gfm_commonmark_5()
    assert_eq(to_html_with(parse_with("- foo\n\n\t\tbar\n", gfm()), gfm_html()), "<ul>\n<li>\n<p>foo</p>\n<pre><code>  bar\n</code></pre>\n</li>\n</ul>\n")

@test("example 6 with the GitHub extensions")
gfm_commonmark_6()
    assert_eq(to_html_with(parse_with(">\t\tfoo\n", gfm()), gfm_html()), "<blockquote>\n<pre><code>  foo\n</code></pre>\n</blockquote>\n")

@test("example 7 with the GitHub extensions")
gfm_commonmark_7()
    assert_eq(to_html_with(parse_with("-\t\tfoo\n", gfm()), gfm_html()), "<ul>\n<li>\n<pre><code>  foo\n</code></pre>\n</li>\n</ul>\n")

@test("example 8 with the GitHub extensions")
gfm_commonmark_8()
    assert_eq(to_html_with(parse_with("    foo\n\tbar\n", gfm()), gfm_html()), "<pre><code>foo\nbar\n</code></pre>\n")

@test("example 9 with the GitHub extensions")
gfm_commonmark_9()
    assert_eq(to_html_with(parse_with(" - foo\n   - bar\n\t - baz\n", gfm()), gfm_html()), "<ul>\n<li>foo\n<ul>\n<li>bar\n<ul>\n<li>baz</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n")

@test("example 10 with the GitHub extensions")
gfm_commonmark_10()
    assert_eq(to_html_with(parse_with("#\tFoo\n", gfm()), gfm_html()), "<h1>Foo</h1>\n")

@test("example 11 with the GitHub extensions")
gfm_commonmark_11()
    assert_eq(to_html_with(parse_with("*\t*\t*\t\n", gfm()), gfm_html()), "<hr />\n")

@test("example 12 with the GitHub extensions")
gfm_commonmark_12()
    assert_eq(to_html_with(parse_with("\\!\\\"\\#\\$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\`\\{\\|\\}\\~\n", gfm()), gfm_html()), "<p>!&quot;#$%&amp;'()*+,-./:;&lt;=&gt;?@[\\]^_`{|}~</p>\n")

@test("example 13 with the GitHub extensions")
gfm_commonmark_13()
    assert_eq(to_html_with(parse_with("\\\t\\A\\a\\ \\3\\\u{3c6}\\\u{ab}\n", gfm()), gfm_html()), "<p>\\\t\\A\\a\\ \\3\\\u{3c6}\\\u{ab}</p>\n")

@test("example 14 with the GitHub extensions")
gfm_commonmark_14()
    assert_eq(to_html_with(parse_with("\\*not emphasized*\n\\<br/> not a tag\n\\[not a link](/foo)\n\\`not code`\n1\\. not a list\n\\* not a list\n\\# not a heading\n\\[foo]: /url \"not a reference\"\n\\&ouml; not a character entity\n", gfm()), gfm_html()), "<p>*not emphasized*\n&lt;br/&gt; not a tag\n[not a link](/foo)\n`not code`\n1. not a list\n* not a list\n# not a heading\n[foo]: /url &quot;not a reference&quot;\n&amp;ouml; not a character entity</p>\n")

@test("example 15 with the GitHub extensions")
gfm_commonmark_15()
    assert_eq(to_html_with(parse_with("\\\\*emphasis*\n", gfm()), gfm_html()), "<p>\\<em>emphasis</em></p>\n")

@test("example 16 with the GitHub extensions")
gfm_commonmark_16()
    assert_eq(to_html_with(parse_with("foo\\\nbar\n", gfm()), gfm_html()), "<p>foo<br />\nbar</p>\n")

@test("example 17 with the GitHub extensions")
gfm_commonmark_17()
    assert_eq(to_html_with(parse_with("`` \\[\\` ``\n", gfm()), gfm_html()), "<p><code>\\[\\`</code></p>\n")

@test("example 18 with the GitHub extensions")
gfm_commonmark_18()
    assert_eq(to_html_with(parse_with("    \\[\\]\n", gfm()), gfm_html()), "<pre><code>\\[\\]\n</code></pre>\n")

@test("example 19 with the GitHub extensions")
gfm_commonmark_19()
    assert_eq(to_html_with(parse_with("~~~\n\\[\\]\n~~~\n", gfm()), gfm_html()), "<pre><code>\\[\\]\n</code></pre>\n")

@test("example 20 with the GitHub extensions")
gfm_commonmark_20()
    assert_eq(to_html_with(parse_with("<https://example.com?find=\\*>\n", gfm()), gfm_html()), "<p><a href=\"https://example.com?find=%5C*\">https://example.com?find=\\*</a></p>\n")

@test("example 21 with the GitHub extensions")
gfm_commonmark_21()
    assert_eq(to_html_with(parse_with("<a href=\"/bar\\/)\">\n", gfm()), gfm_html()), "<a href=\"/bar\\/)\">\n")

@test("example 22 with the GitHub extensions")
gfm_commonmark_22()
    assert_eq(to_html_with(parse_with("[foo](/bar\\* \"ti\\*tle\")\n", gfm()), gfm_html()), "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>\n")

@test("example 23 with the GitHub extensions")
gfm_commonmark_23()
