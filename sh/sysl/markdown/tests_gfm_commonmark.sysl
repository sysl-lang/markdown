@test("example 25 with the GitHub extensions")
gfm_commonmark_25()
    assert_eq(to_html_with(parse_with("&nbsp; &amp; &copy; &AElig; &Dcaron;\n&frac34; &HilbertSpace; &DifferentialD;\n&ClockwiseContourIntegral; &ngE;\n", gfm()), gfm_html()), "<p>\u{a0} &amp; \u{a9} \u{c6} \u{10e}\n\u{be} \u{210b} \u{2146}\n\u{2232} \u{2267}\u{338}</p>\n")

