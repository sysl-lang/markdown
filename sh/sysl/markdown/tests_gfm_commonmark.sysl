gfm_commonmark_27()
    assert_eq(to_html_with(parse_with("&#X22; &#XD06; &#xcab;\n", gfm()), gfm_html()), "<p>&quot; \u{d06} \u{cab}</p>\n")

@test("example 28 with the GitHub extensions")
gfm_commonmark_28()
    assert_eq(to_html_with(parse_with("&nbsp &x; &#; &#x;\n&#87654321;\n&#abcdef0;\n&ThisIsNotDefined; &hi?;\n", gfm()), gfm_html()), "<p>&amp;nbsp &amp;x; &amp;#; &amp;#x;\n&amp;#87654321;\n&amp;#abcdef0;\n&amp;ThisIsNotDefined; &amp;hi?;</p>\n")

