    assert_eq(to_html(parse("*$*alpha.\n\n*\u{a3}*bravo.\n\n*\u{20ac}*charlie.\n")), "<p>*$*alpha.</p>\n<p>*\u{a3}*bravo.</p>\n<p>*\u{20ac}*charlie.</p>\n")

