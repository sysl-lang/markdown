module sh.sysl.markdown
@tests

// The CommonMark 0.31.2 spec's examples from 'Emphasis and strong emphasis', each rendered and compared exactly.
// Written by tools/gen_spec_tests.py from spec/spec.json; edit that, not this.

@test("example 350", ignore: "the parser does not read Emphasis and strong emphasis")
example_350()
    assert_eq(to_html(parse("*foo bar*\n")), "<p><em>foo bar</em></p>\n")

@test("example 351", ignore: "the parser does not read Emphasis and strong emphasis")
example_351()
    assert_eq(to_html(parse("a * foo bar*\n")), "<p>a * foo bar*</p>\n")

@test("example 352", ignore: "the parser does not read Emphasis and strong emphasis")
example_352()
    assert_eq(to_html(parse("a*\"foo\"*\n")), "<p>a*&quot;foo&quot;*</p>\n")

